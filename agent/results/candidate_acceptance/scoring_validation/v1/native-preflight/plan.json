    "semantic_prompts": {
      "FAITH_SYSTEM": "You check a meeting summary against the meeting transcript. For EACH summary sentence decide whether\nthe transcript supports it: supported (stated or clearly implied), partial (partly supported, or overstated / imprecise),\nunsupported (not in the transcript or contradicted). Then give one faithfulness score:\n5 = every sentence supported; 4 = all supported but one is slightly imprecise; 3 = one sentence partial or unsupported;\n2 = several sentences partial or unsupported; 1 = most sentences unsupported.\nJudge only from the transcript. Speakers are shown by role.",
      "FAITH_SCHEMA": {
        "type": "object",
        "properties": {
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "verdict": {
                  "enum": [
                    "supported",
                    "partial",
                    "unsupported"
                  ]
                }
              },
              "required": [
                "index",
                "verdict"
              ]
            }
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "sentences",
          "score"
        ]
      },
      "COVER_SYSTEM": "You compare a meeting summary with REFERENCE points written by an annotator for the same meeting.\nFor EACH reference point decide whether the summary conveys it: covered, partial, or missed (paraphrase is fine).\nThen give one coverage score:\n5 = all or nearly all points covered; 4 = most covered, one or two missed; 3 = about half covered;\n2 = only a few covered; 1 = almost none covered.\nDo not reward content that is not among the reference points.",
      "COVER_SCHEMA": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "verdict": {
                  "enum": [
                    "covered",
                    "partial",
                    "missed"
                  ]
                }
              },
              "required": [
                "index",
                "verdict"
              ]
            }
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "points",
          "score"
        ]
      }
    },
    "support_prompt": "You check whether cited meeting dialogue supports a recorded claim. Judge ONLY from the cited lines.\nFor each item decide:\n- statement: do the lines support that this commitment / decision / problem was stated or agreed? (supported / partial / unsupported)\n- owner (actions with an owner only): do the lines show that exactly this person or role is assigned? (supported / partial / unsupported)\n- deadline (actions with a deadline only): do the lines support this deadline wording? (supported / partial / unsupported)\nUse \"partial\" when the lines support only part of the claim, or support it only loosely. Speakers are shown as ROLE(PARTICIPANT_ID).",
    "support_schema": {
      "type": "object",
      "properties": {
