      "observed_dialogue": [
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.11",
          "meeting_id": "IS1008a",
          "text": "I actually didn't know we were designing a remote control ,",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.12",
          "meeting_id": "IS1008a",
          "text": "I thought we were designing a new monitor .",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.15",
          "meeting_id": "IS1008a",
          "text": "So um I'm glad I didn't d do any work um ahead of time",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.48",
          "meeting_id": "IS1008a",
          "text": "Okay .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.23",
          "meeting_id": "IS1008a",
          "text": "but uh do you already have like a functional design or a technical design or <disfmarker>",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.11",
          "meeting_id": "IS1008a",
          "text": "<vocalsound> Uh for the moment not yet .",
          "participant": "MIE085",
          "role": "ME"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.24",
          "meeting_id": "IS1008a",
          "text": "Oh for the moment not yet , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.13",
          "meeting_id": "IS1008a",
          "text": "No ,",
          "participant": "MIE085",
          "role": "ME"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.14",
          "meeting_id": "IS1008a",
          "text": "this is like I said that we have to be discussed between all of us and we'll go from there .",
          "participant": "MIE085",
          "role": "ME"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.29",
          "meeting_id": "IS1008a",
          "text": "so uh by when you think you can uh give me some kind of uh project plan , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.30",
          "meeting_id": "IS1008a",
          "text": "a discussion with uh <disfmarker>",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.16",
          "meeting_id": "IS1008a",
          "text": "Certainly by the next meeting .",
          "participant": "MIE085",
          "role": "ME"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.10",
          "participant": "FIE073",
          "role": "ID",
          "text": "and um I uh"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.13",
          "participant": "FIE073",
          "role": "ID",
          "text": "Um the website I went to look at had some announcements about an introduction of a um uh some sort of a seven inch um monitor ,"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.14",
          "participant": "FIE073",
          "role": "ID",
          "text": "and um I understood that that was the project goal ."
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.16",
          "participant": "FIE073",
          "role": "ID",
          "text": "because uh I clearly didn't understand the project goal ."
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.17",
          "participant": "FIE073",
          "role": "ID",
          "text": "Um I just did s see that we were starting a new project together"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.22",
          "participant": "MIO086",
          "role": "PM",
          "text": "Mm-hmm"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.25",
          "participant": "MIO086",
          "role": "PM",
          "text": "but uh what's what's your uh <disfmarker>"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.12",
          "participant": "MIE085",
          "role": "ME",
          "text": "<vocalsound> Good question <vocalsound> ."
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.15",
          "participant": "MIE085",
          "role": "ME",
          "text": "We'll have to <disfmarker> simply we'll have to work on it together ."
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.28",
          "participant": "MIO086",
          "role": "PM",
          "text": "Okay ,"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.31",
          "participant": "MIO086",
          "role": "PM",
          "text": "By next meeting , okay that will be great ."
        }
      ],
