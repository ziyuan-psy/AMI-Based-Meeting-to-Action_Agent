    "observed_dialogue": [
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.11",
        "meeting_id": "IS1008a",
        "text": "I actually didn't know we were designing a remote control ,",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.12",
        "meeting_id": "IS1008a",
        "text": "I thought we were designing a new monitor .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.15",
        "meeting_id": "IS1008a",
        "text": "So um I'm glad I didn't d do any work um ahead of time",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.16",
        "meeting_id": "IS1008a",
        "text": "because uh I clearly didn't understand the project goal .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.48",
        "meeting_id": "IS1008a",
        "text": "Okay .",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.10",
        "participant": "FIE073",
        "role": "ID",
        "text": "and um I uh"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.13",
        "participant": "FIE073",
        "role": "ID",
        "text": "Um the website I went to look at had some announcements about an introduction of a um uh some sort of a seven inch um monitor ,"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.14",
        "participant": "FIE073",
        "role": "ID",
        "text": "and um I understood that that was the project goal ."
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.17",
        "participant": "FIE073",
        "role": "ID",
        "text": "Um I just did s see that we were starting a new project together"
      }
    ],
