        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.5",
          "meeting_id": "TS3006a",
          "text": "I'm afraid I'm a bit slow for this stuff uh .",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.7",
          "meeting_id": "TS3006a",
          "text": "<vocalsound> I don't know how much preparation you guys did ,",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.8",
          "meeting_id": "TS3006a",
          "text": "but not a lot .",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.11",
          "meeting_id": "TS3006a",
          "text": "No , it's <disfmarker> it was uh not enough .",
          "participant": "MTD023UID",
          "role": "UI"
        },
        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.17",
          "meeting_id": "TS3006a",
          "text": "How much time do we have to draw anyway ? <vocalsound>",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.26",
          "meeting_id": "TS3006a",
          "text": "<vocalsound>",
          "participant": "MTD023UID",
          "role": "UI"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.60",
          "meeting_id": "TS3006a",
          "text": "<vocalsound> Yeah .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.18",
          "meeting_id": "TS3006a",
          "text": "'Cause I can take forever on this .",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.8",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "Kick-off meeting , wow ."
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.9",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "It's uh looks uh nice ."
        },
        {
          "da_id": "TS3006a.C.dialog-act.vkaraisk.6",
          "participant": "MTD022ID",
          "role": "ID",
          "text": "I'm afraid I'm a bit too slow ."
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.12",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "Yeah ."
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.16",
          "participant": "MTD024ME",
          "role": "ME",
          "text": "Yeah ."
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.7",
          "participant": "MTD021PM",
          "role": "PM",
          "text": "You see this beautiful presentation ."
        },
        {
          "da_id": "TS3006a.B.dialog-act.vkaraisk.25",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "No ."
        },
