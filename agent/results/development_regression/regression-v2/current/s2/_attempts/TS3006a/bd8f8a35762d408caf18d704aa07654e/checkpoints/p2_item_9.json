        "da_id": "TS3006a.A.dialog-act.vkaraisk.130",
        "meeting_id": "TS3006a",
        "text": "Um we can sell them at twenty five Euros . Uh",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.131",
        "meeting_id": "TS3006a",
        "text": "the aim is to reach <disfmarker> uh uh to sell as much as fifty million Euros .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.133",
        "meeting_id": "TS3006a",
        "text": "And the production cost should be the half of the selling price .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006a.C.dialog-act.vkaraisk.73",
        "meeting_id": "TS3006a",
        "text": "So we have to s",
        "participant": "MTD022ID",
        "role": "ID"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.129",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "we have a financial aspect to this project . <vocalsound>"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.132",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Uh that's quite a big amount of money ."
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.134",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Okay"
      }
    ],
