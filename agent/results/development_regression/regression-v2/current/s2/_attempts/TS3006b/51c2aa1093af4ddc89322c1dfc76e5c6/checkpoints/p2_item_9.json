    "observed_dialogue": [
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.101",
        "meeting_id": "TS3006b",
        "text": "Yeah that's that's why uh I wanted to to make yeah two uh different uh yeah groups of functions .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.102",
        "meeting_id": "TS3006b",
        "text": "The the simple functions for for the the whole public , and the the advanced options for the younger people yeah who are more yeah experienced with uh <disfmarker>",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006b.C.dialog-act.dharshi.106",
        "meeting_id": "TS3006b",
        "text": "Yeah .",
        "participant": "MTD022ID",
        "role": "ID"
      },
      {
        "da_id": "TS3006b.C.dialog-act.dharshi.105",
        "participant": "MTD022ID",
        "role": "ID",
        "text": "And yeah that you can choose what the design displays , or wha whatever ."
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.152",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Mm-hmm ."
      }
    ],
    "peer_items": [
      {
        "item_key": "TS3006b#0",
        "type": "actions",
        "text": "The User Interface Designer will design the LCD screen function menu."
      },
      {
        "item_key": "TS3006b#1",
        "type": "problems",
        "text": "Unclear what functions we had to include yet."
      },
      {
        "item_key": "TS3006b#2",
        "type": "problems",
        "text": "Elderly users may not understand the remote well; a simpler remote is needed."
      },
      {
        "item_key": "TS3006b#3",
        "type": "actions",
        "text": "The User Interface Designer will prepare a list of the functions to be shown on the screen/menu."
      },
      {
        "item_key": "TS3006b#4",
        "type": "actions",
        "text": "The User Interface Designer will group the menu into a display group and a basic functions group."
      },
      {
        "item_key": "TS3006b#5",
        "type": "actions",
        "text": "The Project Manager will reorganize the project materials after this meeting."
      },
      {
        "item_key": "TS3006b#6",
        "type": "actions",
        "text": "The User Interface Designer will create maps of the data gathered for the project."
      },
      {
        "item_key": "TS3006b#7",
        "type": "decisions",
        "text": "Teletext functionality will be skipped and not used in the project."
      },
      {
        "item_key": "TS3006b#8",
        "type": "decisions",
        "text": "The target age range is sixteen to forty."
      }
    ]
  },
