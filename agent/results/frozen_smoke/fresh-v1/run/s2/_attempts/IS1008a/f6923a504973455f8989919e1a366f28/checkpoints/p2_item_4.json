    "observed_dialogue": [
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.60",
        "meeting_id": "IS1008a",
        "text": "so like uh what's your functional design , what's your technical design , and uh how many people you need for this project , and what's the time frame you're looking , okay , and what is the budget , maybe uh initial budget you're looking , okay , and uh how is going to the market , okay ,",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.34",
        "meeting_id": "IS1008a",
        "text": "Mm-hmm .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.35",
        "meeting_id": "IS1008a",
        "text": "Mm-hmm .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.63",
        "meeting_id": "IS1008a",
        "text": "okay , so I need some kind of uh uh the plan in the writing from you .",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.36",
        "meeting_id": "IS1008a",
        "text": "<vocalsound> And when would you like that ?",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.37",
        "meeting_id": "IS1008a",
        "text": "<vocalsound> Uh well if uh if we have enough time uh then d do you think um two weeks is a <disfmarker> is close enough ?",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.66",
        "meeting_id": "IS1008a",
        "text": "Yes I think uh that would be good ,",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.59",
        "participant": "MIO086",
        "role": "PM",
        "text": "Yeah , but uh I need something in the writing ,"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.61",
        "participant": "MIO086",
        "role": "PM",
        "text": "so you've you've had to meet with the marketing team and how they're going to market and what are the marketing strategic plan , okay ,"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.62",
        "participant": "MIO086",
        "role": "PM",
        "text": "when are you going to introduce , okay , and by the time you introduce the product and uh you know there there would be a competition ,"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.64",
        "participant": "MIO086",
        "role": "PM",
        "text": "Okay , and it's po"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.65",
        "participant": "MIO086",
        "role": "PM",
        "text": "B as soon as possible ."
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.67",
        "participant": "MIO086",
        "role": "PM",
        "text": "because I need to go to the management and uh tell them what we are going to do , and uh what cost is , okay , and what's the time frame and what's the project plan ,"
      }
    ],
    "peer_items": [
      {
        "item_key": "IS1008a#0",
        "type": "actions",
        "text": "A written project plan will be prepared and delivered by the next meeting."
      },
