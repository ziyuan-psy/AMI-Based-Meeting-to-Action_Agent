    "observed_dialogue": [
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.50",
        "meeting_id": "TS3006b",
        "text": "And the new product should reach new markets , which is the customers below forty .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.49",
        "meeting_id": "TS3006b",
        "text": "Our current customers are in the age group forty plus .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.83",
        "meeting_id": "TS3006b",
        "text": "Yeah ?",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.135",
        "meeting_id": "TS3006b",
        "text": "Uh it should be designed for a use g uh group below forty ,",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.136",
        "meeting_id": "TS3006b",
        "text": "but I don't think it's w wrong if we can uh target the current customer group as well .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.147",
        "meeting_id": "TS3006b",
        "text": "So is it from sixteen to forty ? Is it from twenty to forty ? Is it from thirty ?",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.174",
        "meeting_id": "TS3006b",
        "text": "Uh sixteen to forty .",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.98",
        "meeting_id": "TS3006b",
        "text": "Yeah .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.84",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "Below ?"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.82",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "I thought I read a <disfmarker>"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.133",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "for those that didn't see yet um the basic new requirements of the management were no teletext , only for T_V_ ."
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.165",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "Mm ."
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.173",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "How do you mean ?"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.148",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Yeah ? 'Kay ."
      }
    ],
    "peer_items": [
      {
        "item_key": "TS3006b#0",
        "type": "actions",
        "text": "The User Interface Designer will design the basic function menu for the LCD screen."
      },
      {
        "item_key": "TS3006b#1",
        "type": "actions",
        "text": "The ID will handle the layout design of the remote."
      },
      {
        "item_key": "TS3006b#2",
        "type": "actions",
        "text": "The User Interface Designer will design a menu for all functions and create a page-based menu."
      },
      {
        "item_key": "TS3006b#3",
        "type": "problems",
        "text": "One participant reported that their computer is not functioning properly."
      },
      {
        "item_key": "TS3006b#4",
        "type": "actions",
        "text": "The Project Manager will organize the project maps/minutes into three groups."
      },
      {
        "item_key": "TS3006b#5",
        "type": "problems",
        "text": "The presenter's display is reduced in size, and there are related screen issues affecting the session."
      },
      {
        "item_key": "TS3006b#6",
        "type": "problems",
        "text": "Uncertainty remains about whether the display should be placed on the top or bottom/side and the potential for the display to be blocked by the user's hand."
      },
      {
        "item_key": "TS3006b#7",
        "type": "decisions",
        "text": "Include LCD screen and speech recognition as new features."
      },
      {
        "item_key": "TS3006b#8",
        "type": "decisions",
        "text": "Target the product at users below forty, with the option to also target the current customer group."
      },
      {
        "item_key": "TS3006b#9",
        "type": "decisions",
        "text": "No teletext functionality will be included; the product is designed for TV use only."
      }
