        },
        {
          "item_key": "TS3006b#12",
          "type": "decisions",
          "text": "The remote design will reflect corporate identity: logo on the top and colors aligned with corporate identity."
        },
        {
          "item_key": "TS3006b#13",
          "type": "decisions",
          "text": "The logo must be present and the colours must align with corporate identity; place the logo on the top area of the remote."
