      "observed_dialogue": [
        {
          "da_id": "TS3006b.B.dialog-act.dharshi.162",
          "meeting_id": "TS3006b",
          "text": "Okay .",
          "participant": "MTD023UID",
          "role": "UI"
        },
        {
          "da_id": "TS3006b.B.dialog-act.dharshi.161",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "Yeah ."
        },
        {
          "da_id": "TS3006b.B.dialog-act.dharshi.163",
          "participant": "MTD023UID",
          "role": "UI",
          "text": "Y you you are going to make a list of what functions are uh are going to to be on the the screen , the menu screen ."
        }
      ],
      "peer_items": [
        {
          "item_key": "TS3006b#0",
          "type": "actions",
          "text": "The User Interface Designer can design a menu for all these functions."
        },
        {
          "item_key": "TS3006b#1",
          "type": "problems",
          "text": "The current look-and-feel and usability of remote controls are disliked by users and are hard to learn, with remotes often getting lost in rooms."
        },
        {
          "item_key": "TS3006b#2",
          "type": "problems",
          "text": "Open problem: it is unclear what the screen should do or what is required from it."
        },
        {
          "item_key": "TS3006b#3",
          "type": "problems",
          "text": "Uncertainty about saving the project file (whether it saves automatically and where)."
        },
        {
          "item_key": "TS3006b#4",
          "type": "decisions",
          "text": "The target group will be sixteen to forty."
        },
        {
          "item_key": "TS3006b#5",
          "type": "decisions",
          "text": "The basic new requirements of the management were no teletext, only for T_V_."
        },
        {
          "item_key": "TS3006b#6",
          "type": "decisions",
          "text": "Teletext and the newsflash feature will not be used in the future."
        },
        {
          "item_key": "TS3006b#7",
          "type": "decisions",
          "text": "Keep all classic remote functions and improve button usability and the physical design."
        },
        {
          "item_key": "TS3006b#8",
          "type": "decisions",
          "text": "The product must include corporate identity with the logo present and colours consistent."
        },
        {
          "item_key": "TS3006b#9",
          "type": "actions",
          "text": "The PM will write the meeting minutes."
        },
        {
          "item_key": "TS3006b#10",
          "type": "actions",
          "text": "The UI Designer will group the functions into two groups: display functions and basic functions."
        }
      ],
