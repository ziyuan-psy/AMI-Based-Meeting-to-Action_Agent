      "observed_dialogue": [
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.85",
          "meeting_id": "IS1008a",
          "text": "Yes , so what I uh prefer maybe uh you need to interact uh more with the Christine , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.86",
          "meeting_id": "IS1008a",
          "text": "because you know what she is going to do it , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.87",
          "meeting_id": "IS1008a",
          "text": "and you know how to sell it . Okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.88",
          "meeting_id": "IS1008a",
          "text": "because uh she is doing the design ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.89",
          "meeting_id": "IS1008a",
          "text": "but you are the core because you are in the marketing , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.43",
          "meeting_id": "IS1008a",
          "text": "Yeah .",
          "participant": "MIE085",
          "role": "ME"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.90",
          "meeting_id": "IS1008a",
          "text": "so because you need to sell <disfmarker> and you're the responsible for the all the money , the finance , okay , tomorrow .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.B.dialog-act.s9553330.10",
          "meeting_id": "IS1008a",
          "text": "So I think I'll have to interact with Christine and discuss with her , so that she's not designing something that my studies will show right off the bat that it's not going to work ,",
          "participant": "FIE038",
          "role": "UI"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.106",
          "meeting_id": "IS1008a",
          "text": "Th Christine , yeah <vocalsound> .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.107",
          "meeting_id": "IS1008a",
          "text": "Which is <disfmarker>",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.42",
          "participant": "MIE085",
          "role": "ME",
          "text": "and then it's gotta be simple to use ."
        },
        {
          "da_id": "IS1008a.D.dialog-act.s9553330.44",
          "participant": "MIE085",
          "role": "ME",
          "text": "Mm-hmm ."
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.105",
          "participant": "MIO086",
          "role": "PM",
          "text": "Yeah ."
        },
        {
          "da_id": "IS1008a.B.dialog-act.s9553330.11",
          "participant": "FIE038",
          "role": "UI",
          "text": "and so it's sort of <disfmarker> it's a loop that feeds in ,"
        }
      ],
