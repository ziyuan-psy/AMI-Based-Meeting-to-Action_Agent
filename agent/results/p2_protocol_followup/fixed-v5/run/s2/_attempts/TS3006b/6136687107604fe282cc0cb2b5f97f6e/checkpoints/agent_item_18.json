      ],
      "observed_dialogue": [
        {
          "da_id": "TS3006b.B.dialog-act.dharshi.101",
          "meeting_id": "TS3006b",
          "text": "Yeah that's that's why uh I wanted to to make yeah two uh different uh yeah groups of functions .",
          "participant": "MTD023UID",
          "role": "UI"
        },
        {
          "da_id": "TS3006b.B.dialog-act.dharshi.102",
          "meeting_id": "TS3006b",
          "text": "The the simple functions for for the the whole public , and the the advanced options for the younger people yeah who are more yeah experienced with uh <disfmarker>",
          "participant": "MTD023UID",
          "role": "UI"
        },
        {
          "da_id": "TS3006b.C.dialog-act.dharshi.106",
          "meeting_id": "TS3006b",
          "text": "Yeah .",
          "participant": "MTD022ID",
          "role": "ID"
        },
        {
          "da_id": "TS3006b.A.dialog-act.dharshi.152",
          "meeting_id": "TS3006b",
          "text": "Mm-hmm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006b.C.dialog-act.dharshi.105",
          "participant": "MTD022ID",
          "role": "ID",
          "text": "And yeah that you can choose what the design displays , or wha whatever ."
        },
        {
          "da_id": "TS3006b.A.dialog-act.dharshi.153",
          "participant": "MTD021PM",
          "role": "PM",
          "text": "<vocalsound> And maybe y"
        }
      ],
      "peer_items": [
        {
          "item_key": "TS3006b#0",
          "type": "actions",
          "text": "The User Interface Designer can design a menu for all these functions."
        },
        {
          "item_key": "TS3006b#1",
          "type": "problems",
          "text": "The current look-and-feel and usability of remote controls are disliked by users and are hard to learn, with remotes often getting lost in rooms."
        },
        {
          "item_key": "TS3006b#2",
          "type": "problems",
          "text": "Open problem: it is unclear what the screen should do or what is required from it."
        },
        {
          "item_key": "TS3006b#3",
          "type": "problems",
          "text": "Uncertainty about saving the project file (whether it saves automatically and where)."
        },
        {
          "item_key": "TS3006b#4",
          "type": "decisions",
          "text": "The target group will be sixteen to forty."
        },
        {
          "item_key": "TS3006b#5",
          "type": "decisions",
          "text": "The basic new requirements of the management were no teletext, only for T_V_."
        },
        {
          "item_key": "TS3006b#6",
          "type": "decisions",
          "text": "Teletext and the newsflash feature will not be used in the future."
        },
        {
          "item_key": "TS3006b#7",
          "type": "decisions",
          "text": "Keep all classic remote functions and improve button usability and the physical design."
        },
        {
          "item_key": "TS3006b#8",
          "type": "decisions",
          "text": "The product must include corporate identity with the logo present and colours consistent."
        },
        {
          "item_key": "TS3006b#9",
          "type": "actions",
          "text": "The PM will write the meeting minutes."
        },
        {
          "item_key": "TS3006b#10",
          "type": "actions",
          "text": "The UI Designer will group the functions into two groups: display functions and basic functions."
        },
        {
          "item_key": "TS3006b#11",
          "type": "actions",
          "text": "The UI Designer will compile a list of the functions to be on the LCD screen menu."
        },
        {
          "item_key": "TS3006b#12",
          "type": "actions",
          "text": "The UI Designer will implement a paged LCD menu."
        },
        {
          "item_key": "TS3006b#13",
          "type": "actions",
          "text": "The ID will integrate the channel-changing functionality into the design."
        },
        {
          "item_key": "TS3006b#14",
          "type": "actions",
          "text": "The UI Designer will position the LCD screen on top and separate advanced functions from basic functions."
        },
        {
          "item_key": "TS3006b#15",
          "type": "actions",
          "text": "The UI Designer will add LED indicator lights under the buttons to show which buttons are active."
        },
        {
          "item_key": "TS3006b#16",
          "type": "actions",
          "text": "The UI Designer will implement a two-button scheme: one OK/confirm button and one navigation button, plus a back button."
        },
        {
          "item_key": "TS3006b#17",
          "type": "actions",
          "text": "The UI Designer will consider a plan to group advanced options in the on-screen display while keeping basic functions visible on the device itself."
        }
      ],
