      "observed_dialogue": [
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.42",
          "meeting_id": "IS1008a",
          "text": "Would you mind um at the conclusion of our meeting could could you send us a copy of your slides ?",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.130",
          "meeting_id": "IS1008a",
          "text": "Yes , I will . Yes .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.131",
          "meeting_id": "IS1008a",
          "text": "I'll copy , uh",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.132",
          "meeting_id": "IS1008a",
          "text": "le let us keep all the emails and all the copies , okay , share each other , okay , so you know everybody what's happening , okay ?",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.129",
          "participant": "MIO086",
          "role": "PM",
          "text": "Thanks for coming ."
        },
        {
          "da_id": "IS1008a.B.dialog-act.s9553330.30",
          "participant": "FIE038",
          "role": "UI",
          "text": "Mm-hmm ,"
        },
        {
          "da_id": "IS1008a.B.dialog-act.s9553330.31",
          "participant": "FIE038",
          "role": "UI",
          "text": "yeah , that would be useful ."
        },
        {
          "da_id": "IS1008a.B.dialog-act.s9553330.32",
          "participant": "FIE038",
          "role": "UI",
          "text": "Sure ."
        }
      ],
      "peer_items": [
        {
          "item_key": "IS1008a#0",
          "type": "problems",
          "text": "The project goals are unclear, with confusion over whether the product is a remote control or a monitor, and there is no functional or technical design yet; design work has not begun."
        },
        {
          "item_key": "IS1008a#1",
          "type": "actions",
          "text": "ID(FIE073) will provide a written plan covering the functional design, technical design, required team, budget, and market strategy within two weeks."
        },
        {
          "item_key": "IS1008a#2",
          "type": "problems",
          "text": "PM cannot present to management without a written plan and cost/time estimates, and funding requests cannot be made because the plan/documentation is not prepared."
        },
        {
          "item_key": "IS1008a#3",
          "type": "actions",
          "text": "UI(FIE038) will interact with Christine to ensure usability requirements are considered and coordinate with marketing on usability findings."
        },
        {
          "item_key": "IS1008a#4",
          "type": "actions",
          "text": "FIE038 will start determining the functional design."
        }
      ],
