          "participant": "MTD021PM",
          "role": "PM",
          "text": "Uh did any of you already do some work on this part"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.168",
          "participant": "MTD021PM",
          "role": "PM",
          "text": "Mm-hmm ."
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.111",
          "participant": "MTD024ME",
          "role": "ME",
          "text": "So"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.172",
          "participant": "MTD021PM",
          "role": "PM",
          "text": "Mm-hmm ."
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.173",
          "participant": "MTD021PM",
          "role": "PM",
          "text": "Yep ."
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.117",
          "participant": "MTD024ME",
          "role": "ME",
          "text": "So we can see uh what needs to be supported ."
        },
