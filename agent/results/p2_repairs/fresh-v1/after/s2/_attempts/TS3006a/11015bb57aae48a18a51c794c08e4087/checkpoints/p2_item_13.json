        "item_key": "TS3006a#0",
        "type": "actions",
        "text": "The Industrial Designer will produce a working design."
      },
      {
        "item_key": "TS3006a#1",
        "type": "problems",
        "text": "User requirements are not yet defined; unclear which components should be included in the design, and there is a need for better communication about requirements and design details to avoid miscommunication."
      },
      {
        "item_key": "TS3006a#2",
        "type": "actions",
        "text": "The User Interface Designer will specify the technical functions."
      },
      {
        "item_key": "TS3006a#3",
        "type": "problems",
        "text": "Unclear which components should be included in the design, making progress difficult without clearer component guidance."
      },
      {
        "item_key": "TS3006a#4",
        "type": "actions",
        "text": "The Marketing Expert will come up with user requirements by performing market research and user interviews."
      },
      {
        "item_key": "TS3006a#5",
        "type": "problems",
        "text": "There is a need for better communication about requirements and design details to avoid miscommunication."
      },
      {
        "item_key": "TS3006a#6",
        "type": "actions",
        "text": "The Industrial Designer will work on the conceptual design."
      },
      {
        "item_key": "TS3006a#7",
        "type": "actions",
        "text": "The Project Manager will summarise the discussed items and put them in the project folder."
      },
      {
        "item_key": "TS3006a#8",
        "type": "decisions",
        "text": "The product's selling price will be set at 25 Euros."
      },
      {
        "item_key": "TS3006a#9",
        "type": "decisions",
        "text": "Production cost should be half of the selling price."
      },
      {
        "item_key": "TS3006a#10",
        "type": "decisions",
        "text": "The group aims to achieve sales of 50 million Euros."
      },
      {
        "item_key": "TS3006a#11",
        "type": "decisions",
        "text": "The project will be structured into three phases."
      },
      {
        "item_key": "TS3006a#12",
        "type": "decisions",
        "text": "We should start with TV and video only, with the possibility to add other features later."
      }
