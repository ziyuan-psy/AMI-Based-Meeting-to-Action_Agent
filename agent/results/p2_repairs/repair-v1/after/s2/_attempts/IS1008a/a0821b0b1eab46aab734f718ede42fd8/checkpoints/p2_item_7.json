    ],
    "observed_dialogue": [
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.20",
        "meeting_id": "IS1008a",
        "text": "From what I had in mind we're supposed to be marketing coffee ,",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.21",
        "meeting_id": "IS1008a",
        "text": "is that right ?",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.38",
        "meeting_id": "IS1008a",
        "text": "Oh I think uh , if I'm not wrong , we're making the remote control .",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.22",
        "meeting_id": "IS1008a",
        "text": "Remote controls ,",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.23",
        "meeting_id": "IS1008a",
        "text": "'cause I had two different things .",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.24",
        "meeting_id": "IS1008a",
        "text": "I had a first part of mine was to make a remote control for a new f remote control for television ,",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.25",
        "meeting_id": "IS1008a",
        "text": "and afterward I had a discussion about coffee so <vocalsound>",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.39",
        "meeting_id": "IS1008a",
        "text": "<vocalsound> Yes .",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.26",
        "meeting_id": "IS1008a",
        "text": "we'll start with the remote control for television then .",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.D.dialog-act.s9553330.27",
        "meeting_id": "IS1008a",
        "text": "So we're have to design something that is very user friendly .",
        "participant": "MIE085",
        "role": "ME"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.37",
        "participant": "MIO086",
        "role": "PM",
        "text": "so can you explain uh what exactly the product is ?"
      },
      {
        "da_id": "IS1008a.B.dialog-act.s9553330.4",
        "participant": "FIE038",
        "role": "UI",
        "text": "Um I was wondering <disfmarker>"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.40",
        "participant": "MIO086",
        "role": "PM",
        "text": "Mm-hmm ."
      }
    ],
    "peer_items": [
      {
        "item_key": "IS1008a#0",
        "type": "problems",
        "text": "ID(FIE073) did not understand the project goal and believed the project was a different product, indicating a scope/goal misalignment."
      },
      {
        "item_key": "IS1008a#1",
        "type": "actions",
        "text": "ID will deliver a written plan covering functional and technical design, staffing, timeframe, budget, and market plan by two weeks."
      },
      {
        "item_key": "IS1008a#2",
        "type": "problems",
        "text": "There is no written project plan or budget yet, and documentation is missing to present to management."
      },
      {
        "item_key": "IS1008a#3",
        "type": "actions",
        "text": "ID will identify additional contributors from marketing, technical, and administration for the plan and inform PM."
      },
      {
        "item_key": "IS1008a#4",
        "type": "actions",
        "text": "UI will determine the functional design as the immediate next step."
      },
      {
        "item_key": "IS1008a#5",
        "type": "actions",
        "text": "UI will build the overall plan incorporating inputs from usability, marketing, and design groups."
      },
      {
        "item_key": "IS1008a#6",
        "type": "actions",
        "text": "Ed will provide a written project plan by the next meeting."
      }
    ],
