    "peer_items": [
      {
        "item_key": "TS3006a#0",
        "type": "problems",
        "text": "There is a hardware/display problem as the presenter reports the screen is missing ('where has my screen gone?' and 'My screen is gone')."
      },
      {
        "item_key": "TS3006a#1",
        "type": "actions",
        "text": "The Project Manager will summarize the discussed items and place the summary in the project folder."
      },
      {
        "item_key": "TS3006a#2",
        "type": "problems",
        "text": "Participants report being slow and under-prepared for the kickoff, indicating preparation/co-ordination gaps."
      },
      {
        "item_key": "TS3006a#3",
        "type": "actions",
        "text": "The Industrial Designer will create an overview for the three design phases."
      },
      {
        "item_key": "TS3006a#4",
        "type": "actions",
        "text": "The Industrial Designer will work on the conceptual design."
      },
      {
        "item_key": "TS3006a#5",
        "type": "problems",
        "text": "Unclear scope: unclear which animal to draw and lack of agreement on the subject, as well as unclear which components to include in the design."
      },
      {
        "item_key": "TS3006a#6",
        "type": "actions",
        "text": "The Marketing Expert will conduct internet searches and user interviews to determine user requirements."
      },
      {
        "item_key": "TS3006a#7",
        "type": "actions",
        "text": "The Project Manager will defend our design."
      },
      {
        "item_key": "TS3006a#8",
        "type": "decisions",
        "text": "The activity is introduction and get acquainted."
      },
      {
        "item_key": "TS3006a#9",
        "type": "decisions",
        "text": "Pricing will be set at 25 Euros, with a target of 50 million Euros in sales and production cost equal to half of the selling price."
      },
      {
        "item_key": "TS3006a#10",
        "type": "decisions",
        "text": "Phase one will be the functional design."
      },
      {
        "item_key": "TS3006a#11",
        "type": "decisions",
        "text": "The team will start with the assumption that the system is only for TV and video, and will reserve the possibility to add other features later."
      }
    ],
