  "support": [
    {
      "id": "TS3006b.sys.s.1",
      "text": "The User Interface Designer will design the LCD screen function menu.",
      "verdict": {
        "item": 0,
        "statement": "partial",
        "owner": "na",
        "deadline": "na",
        "note": "LCD screen specificity not explicit; lines show UI designer can design a menu for functions."
      }
    },
    {
      "id": "TS3006b.sys.s.2",
      "text": "Unclear what functions we had to include yet.",
      "verdict": {
        "item": 1,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.3",
      "text": "Elderly users may not understand the remote well; a simpler remote is needed.",
      "verdict": {
        "item": 2,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.4",
      "text": "The User Interface Designer will prepare a list of the functions to be shown on the screen/menu.",
      "verdict": {
        "item": 3,
        "statement": "supported",
        "owner": "supported",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.5",
      "text": "The User Interface Designer will group the menu into a display group and a basic functions group.",
      "verdict": {
        "item": 4,
        "statement": "supported",
        "owner": "supported",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.6",
      "text": "The Project Manager will reorganize the project materials after this meeting.",
      "verdict": {
        "item": 5,
        "statement": "partial",
        "owner": "supported",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.7",
      "text": "The User Interface Designer will create maps of the data gathered for the project.",
      "verdict": {
        "item": 6,
        "statement": "supported",
        "owner": "supported",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.8",
      "text": "Teletext functionality will be skipped and not used in the project.",
      "verdict": {
        "item": 7,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.9",
      "text": "The target age range is sixteen to forty.",
      "verdict": {
        "item": 8,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.10",
      "text": "We should have two different groups of functions: simple for the general public and advanced for younger users.",
      "verdict": {
        "item": 9,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.11",
      "text": "The team proposed implementing two menus: a button-based menu for direct access and an LCD/TV options menu activated by software options.",
      "verdict": {
        "item": 10,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.12",
      "text": "The extra advanced options should be on the onscreen display.",
      "verdict": {
        "item": 11,
        "statement": "supported",
        "owner": "supported",
        "deadline": "na"
      }
    },
    {
      "id": "TS3006b.sys.s.13",
      "text": "The screen should be placed on the top.",
      "verdict": {
        "item": 12,
        "statement": "supported",
        "owner": "na",
        "deadline": "na"
      }
    }
