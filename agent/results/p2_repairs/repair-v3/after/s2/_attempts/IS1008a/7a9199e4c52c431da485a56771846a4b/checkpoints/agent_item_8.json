      "observed_dialogue": [
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.37",
          "meeting_id": "IS1008a",
          "text": "<vocalsound> Uh well if uh if we have enough time uh then d do you think um two weeks is a <disfmarker> is close enough ?",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.66",
          "meeting_id": "IS1008a",
          "text": "Yes I think uh that would be good ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.65",
          "participant": "MIO086",
          "role": "PM",
          "text": "B as soon as possible ."
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.67",
          "participant": "MIO086",
          "role": "PM",
          "text": "because I need to go to the management and uh tell them what we are going to do , and uh what cost is , okay , and what's the time frame and what's the project plan ,"
        }
      ],
      "peer_items": [
        {
          "item_key": "IS1008a#0",
          "type": "problems",
          "text": "ID(FIE073) did not understand the project goal and believed the project was a different product, indicating a scope/goal misalignment."
        },
        {
          "item_key": "IS1008a#1",
          "type": "actions",
          "text": "ID will deliver a written plan covering functional and technical design, staffing, timeframe, budget, and market plan by two weeks."
        },
        {
          "item_key": "IS1008a#2",
          "type": "problems",
          "text": "There is no written project plan or budget yet, and documentation is missing to present to management."
        },
        {
          "item_key": "IS1008a#3",
          "type": "actions",
          "text": "ID will identify additional contributors from marketing, technical, and administration for the plan and inform PM."
        },
        {
          "item_key": "IS1008a#4",
          "type": "actions",
          "text": "UI will determine the functional design as the immediate next step."
        },
        {
          "item_key": "IS1008a#5",
          "type": "actions",
          "text": "UI will build the overall plan incorporating inputs from usability, marketing, and design groups."
        },
        {
          "item_key": "IS1008a#6",
          "type": "actions",
          "text": "Ed will provide a written project plan by the next meeting."
        },
        {
          "item_key": "IS1008a#7",
          "type": "decisions",
          "text": "The group decided that the project will focus on designing a remote control for television and will start with that remote control as the first product."
        }
      ],
