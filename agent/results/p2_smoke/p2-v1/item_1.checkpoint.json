          {
            "da_id": "TS3006a.C.dialog-act.vkaraisk.73",
            "participant": "MTD022ID",
            "role": "ID",
            "text": "So we have to s"
          },
          {
            "da_id": "TS3006a.A.dialog-act.vkaraisk.134",
            "participant": "MTD021PM",
            "role": "PM",
            "text": "Okay"
          },
          {
            "da_id": "TS3006a.A.dialog-act.vkaraisk.135",
            "participant": "MTD021PM",
            "role": "PM",
            "text": "now it's time for some discussion ."
          },
          {
            "da_id": "TS3006a.A.dialog-act.vkaraisk.136",
