            "role": "ID",
            "text": "<vocalsound>"
          },
          {
            "da_id": "TS3006a.A.dialog-act.vkaraisk.129",
            "participant": "MTD021PM",
            "role": "PM",
            "text": "we have a financial aspect to this project . <vocalsound>"
          },
