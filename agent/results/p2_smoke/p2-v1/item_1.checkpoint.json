            "participant": "MTD021PM",
            "role": "PM",
            "text": "Um we can sell them at twenty five Euros . Uh"
          },
          {
            "da_id": "TS3006a.A.dialog-act.vkaraisk.131",
            "participant": "MTD021PM",
