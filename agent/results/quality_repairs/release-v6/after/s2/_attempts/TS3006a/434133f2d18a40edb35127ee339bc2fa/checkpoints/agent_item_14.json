      "peer_items": [
        {
          "item_key": "TS3006a#0",
          "type": "problems",
          "text": "Screen/display hardware problem: presenter reports the screen is missing ('where has my screen gone?' / 'My screen is gone')"
        },
        {
          "item_key": "TS3006a#1",
          "type": "problems",
          "text": "Kickoff participation shows participants slow and under-prepared, indicating preparation/coordination gaps."
        },
        {
          "item_key": "TS3006a#2",
          "type": "problems",
          "text": "Unclear scope: unclear which animal to draw and lack of agreement on subject and components to include."
        },
        {
          "item_key": "TS3006a#3",
          "type": "decisions",
          "text": "Pricing will be set at 25 Euros."
        },
        {
          "item_key": "TS3006a#4",
          "type": "decisions",
          "text": "Sales target is 50 million Euros in sales."
        },
        {
          "item_key": "TS3006a#5",
          "type": "decisions",
          "text": "Production cost should be half of the selling price."
        },
        {
          "item_key": "TS3006a#6",
          "type": "decisions",
          "text": "Phase one will be the functional design."
        },
        {
          "item_key": "TS3006a#7",
          "type": "decisions",
          "text": "Assume system for TV and video with potential future features."
        },
        {
          "item_key": "TS3006a#8",
          "type": "decisions",
          "text": "Product must be user-friendly."
        },
        {
          "item_key": "TS3006a#9",
          "type": "decisions",
          "text": "Product should have the least number of functions to simplify usage."
        },
        {
          "item_key": "TS3006a#10",
          "type": "actions",
          "text": "Industrial Designer will work on the conceptual design."
        },
        {
          "item_key": "TS3006a#11",
          "type": "actions",
          "text": "Project Manager will summarize the discussed items and place the summary in the project folder."
        },
        {
          "item_key": "TS3006a#12",
          "type": "actions",
          "text": "Industrial Designer will create an overview for the three design phases."
        },
        {
          "item_key": "TS3006a#13",
          "type": "actions",
          "text": "Marketing Expert will conduct internet searches and user interviews to determine user requirements."
        }
