    "observed_dialogue": [
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.252",
        "meeting_id": "TS3006b",
        "text": "Yeah I mean a screen on top looks more lo logical to me .",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.126",
        "meeting_id": "TS3006b",
        "text": "Okay the <disfmarker> yeah . That's possible .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.127",
        "meeting_id": "TS3006b",
        "text": "Okay we put it on top .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.257",
        "meeting_id": "TS3006b",
        "text": "So we put this on top , and then make the corporate logo",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.124",
        "participant": "MTD023UID",
        "role": "UI",
        "text": "Yeah okay but <gap> only for the basic functi if you're going to use the advanced option , you're going to press the the menu button and then <disfmarker> yeah ."
      },
      {
        "da_id": "TS3006b.C.dialog-act.dharshi.123",
        "participant": "MTD022ID",
        "role": "ID",
        "text": "Normal for logical t"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.209",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Yeah they're used to it ."
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.254",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "So you you just have to reach a little bit for the power button ."
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.128",
        "participant": "MTD023UID",
        "role": "UI",
        "text": "Yeah , okay ."
      },
      {
        "da_id": "TS3006b.B.dialog-act.dharshi.129",
        "participant": "MTD023UID",
        "role": "UI",
        "text": "Yeah ."
      }
    ],
    "peer_items": [
      {
        "item_key": "TS3006b#0",
        "type": "actions",
        "text": "The User Interface Designer will design the LCD screen function menu."
      },
      {
        "item_key": "TS3006b#1",
        "type": "actions",
        "text": "The User Interface Designer will prepare a list of the functions to be shown on the screen/menu."
      },
      {
        "item_key": "TS3006b#2",
        "type": "actions",
        "text": "The UI Designer will group the menu into a display group and a basic functions group."
      },
      {
        "item_key": "TS3006b#3",
        "type": "actions",
        "text": "ID will design the layout of the LCD screen."
      },
      {
        "item_key": "TS3006b#4",
        "type": "problems",
        "text": "Elderly users may not understand the remote well; a simpler remote is needed."
      },
      {
        "item_key": "TS3006b#5",
        "type": "decisions",
        "text": "Teletext functionality will be skipped and not used in the project."
      },
      {
        "item_key": "TS3006b#6",
        "type": "decisions",
        "text": "The target age range is sixteen to forty."
      },
      {
        "item_key": "TS3006b#7",
        "type": "decisions",
        "text": "We should have two different groups of functions: simple for the general public and advanced for younger users."
      },
      {
        "item_key": "TS3006b#8",
        "type": "decisions",
        "text": "The LCD/TV options menu should be activated by software options."
      },
      {
        "item_key": "TS3006b#9",
        "type": "decisions",
        "text": "The extra advanced options should be on the onscreen display."
      }
    ],
