{"chunk_pass": {"key": "ab138e63a09b1550", "candidates": [{"type": "decisions", "text": "We will not include D_V_D_ (DVD) features in the remote design.", "evidence_da_ids": ["ES2011c.A.dialog-act.dharshi.34"], "owner_ids": ["FEE041"], "owner_cue": "PM announced not having D_V_D_", "deadline_cue": null, "owner_basis": "explicit", "deadline": null, "deadline_basis": "missing", "status": "adopted"}, {"type": "decisions", "text": "We will pursue a fashion electronics approach with a fruit-and-vegetable motif.", "evidence_da_ids": ["ES2011c.D.dialog-act.dharshi.14", "ES2011c.D.dialog-act.dharshi.15", "ES2011c.D.dialog-act.dharshi.16", "ES2011c.D.dialog-act.dharshi.18"], "owner_ids": ["FEE044"], "owner_cue": "ME announced fashion-fruit theme adoption", "deadline_cue": null, "owner_basis": "explicit", "deadline": null, "deadline_basis": "missing", "status": "proposed"}, {"type": "decisions", "text": "We need to decide whether the fruit motif should be printed or the remote should look like a fruit.", "evidence_da_ids": ["ES2011c.D.dialog-act.dharshi.31", "ES2011c.D.dialog-act.dharshi.32", "ES2011c.D.dialog-act.dharshi.33"], "owner_ids": ["FEE044"], "owner_cue": "ME raised the decision", "deadline_cue": null, "owner_basis": "explicit", "deadline": null, "deadline_basis": "missing", "status": "proposed"}, {"type": "problems", "text": "The iPod-like button system design option has not been concluded yet.", "evidence_da_ids": ["ES2011c.A.dialog-act.dharshi.10", "ES2011c.A.dialog-act.dharshi.11"], "owner_ids": ["FEE041"], "owner_cue": "PM indicated the design option has not been concluded", "deadline_cue": null, "owner_basis": "explicit", "deadline": null, "deadline_basis": "missing", "status": "open"}, {"type": "decisions", "text": "The group decided that D_V_D_ will not be included.", "evidence_da_ids": ["ES2011c.A.dialog-act.dharshi.34"], "owner_ids": ["FEE041"], "owner_cue": "PM(FEE041): we're actually not having D_V_D_", "deadline_cue": null, "owner_basis": "explicit", "d