    "observed_dialogue": [
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.42",
        "meeting_id": "ES2011b",
        "text": "and then I just wanna mention some new project requirements that came in .",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.43",
        "meeting_id": "ES2011b",
        "text": "Um , teletext is apparently outdated , so <disfmarker> <vocalsound> due to internet popularity , so that's off the list . Um ,",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.B.dialog-act.dharshi.46",
        "meeting_id": "ES2011b",
        "text": "<vocalsound>",
        "participant": "FEE042",
        "role": "ID"
      },
      {
        "da_id": "ES2011b.B.dialog-act.dharshi.47",
        "meeting_id": "ES2011b",
        "text": "<vocalsound>",
        "participant": "FEE042",
        "role": "ID"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.44",
        "meeting_id": "ES2011b",
        "text": "also our remote should be used only for television , um ,",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.159",
        "meeting_id": "ES2011b",
        "text": "So I'll I'll check that and update you on the next <disfmarker>",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.C.dialog-act.dharshi.173",
        "meeting_id": "ES2011b",
        "text": "Okay .",
        "participant": "FEE043",
        "role": "UI"
      },
      {
        "da_id": "ES2011b.C.dialog-act.dharshi.175",
        "meeting_id": "ES2011b",
        "text": "So like if we had that <disfmarker>",
        "participant": "FEE043",
        "role": "UI"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.160",
        "meeting_id": "ES2011b",
        "text": "But we'll hold off on that 'cause <disfmarker>",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.C.dialog-act.dharshi.174",
        "meeting_id": "ES2011b",
        "text": "Yeah .",
        "participant": "FEE043",
        "role": "UI"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.161",
        "meeting_id": "ES2011b",
        "text": "But s yeah uh .",
        "participant": "FEE041",
        "role": "PM"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.41",
        "participant": "FEE041",
        "role": "PM",
        "text": "we'll discuss that"
      },
      {
        "da_id": "ES2011b.A.dialog-act.dharshi.45",
        "participant": "FEE041",
        "role": "PM",
        "text": "no extra internet kinda fancy things , just the remote and the television ."
      },
      {
        "da_id": "ES2011b.B.dialog-act.dharshi.108",
        "participant": "FEE042",
        "role": "ID",
        "text": "Oh yeah ."
      },
      {
        "da_id": "ES2011b.D.dialog-act.dharshi.174",
        "participant": "FEE044",
        "role": "ME",
        "text": "But D_V_D_ players usually have their own remote ."
