      ]
    },
    "current_meeting": "ES2011b",
    "earlier_meetings": [
      "ES2011a"
    ],
    "roster": [
      {
        "speaker": "A",
        "participant_id": "FEE041",
        "role": "PM"
      },
      {
        "speaker": "B",
