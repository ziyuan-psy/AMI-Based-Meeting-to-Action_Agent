      "observed_dialogue": [
        {
          "da_id": "ES2011d.A.dialog-act.dharshi.288",
          "meeting_id": "ES2011d",
          "text": "So I guess we're supposed to write final reports .",
          "participant": "FEE041",
          "role": "PM"
        },
        {
          "da_id": "ES2011d.A.dialog-act.dharshi.289",
          "meeting_id": "ES2011d",
          "text": "'Cause <disfmarker>",
          "participant": "FEE041",
          "role": "PM"
        },
        {
          "da_id": "ES2011d.B.dialog-act.dharshi.195",
          "meeting_id": "ES2011d",
          "text": "All of us ?",
          "participant": "FEE042",
          "role": "ID"
        },
        {
          "da_id": "ES2011d.B.dialog-act.dharshi.194",
          "participant": "FEE042",
          "role": "ID",
          "text": "Especially if you have food ."
        },
        {
          "da_id": "ES2011d.A.dialog-act.dharshi.290",
          "participant": "FEE041",
          "role": "PM",
          "text": "I don't know . Hmm ."
        }
      ],
      "peer_items": [
        {
          "item_key": "ES2011d#0",
          "type": "problems",
          "text": "Locator button integration is not yet designed; how the button attaches to the locator remains undefined, and coordination between the locator and the beeper is not yet designed and requires integration work."
        },
        {
          "item_key": "ES2011d#1",
          "type": "problems",
          "text": "There is ambiguity about the scoring method for the evaluation, specifically whether to sum the scores and divide by four."
        },
        {
          "item_key": "ES2011d#2",
          "type": "problems",
          "text": "Compatibility issues with WordPerfect and reliance on old disks may hamper access to documents."
        },
        {
          "item_key": "ES2011d#3",
          "type": "decisions",
          "text": "We decided on batteries as the power source for the remote."
        },
        {
          "item_key": "ES2011d#4",
          "type": "decisions",
          "text": "We decided that a regular chip would be necessary for the more advanced iPod-like button."
        },
        {
          "item_key": "ES2011d#5",
          "type": "decisions",
          "text": "We will develop a variety of trendy fruit designs for the remote control."
        },
        {
          "item_key": "ES2011d#6",
          "type": "decisions",
          "text": "We went with shape because we were having fun with the play-dough."
        },
        {
          "item_key": "ES2011d#7",
          "type": "decisions",
          "text": "Yeah the broccoli I guess wins."
        },
        {
          "item_key": "ES2011d#8",
          "type": "decisions",
          "text": "Yeah I'd agree with changing the shape ."
        },
        {
          "item_key": "ES2011d#9",
          "type": "decisions",
          "text": "Apparently I'm supposed to use the whiteboard."
        }
      ],
