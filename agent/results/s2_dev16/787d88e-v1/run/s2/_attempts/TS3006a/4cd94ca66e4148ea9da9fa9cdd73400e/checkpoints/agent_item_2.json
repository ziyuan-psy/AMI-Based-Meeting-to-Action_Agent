      "observed_dialogue": [
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.109",
          "meeting_id": "TS3006a",
          "text": "from a marketing uh <vocalsound> perspective , um well the function des design phase uh consists out of the user requirements .",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.168",
          "meeting_id": "TS3006a",
          "text": "Mm-hmm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.110",
          "meeting_id": "TS3006a",
          "text": "Um what needs and desires are to be fulfilled ?",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.111",
          "meeting_id": "TS3006a",
          "text": "So",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.112",
          "meeting_id": "TS3006a",
          "text": "there are a few means to reach that um by by doing research <vocalsound> uh to see what existing products are there out in the market .",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.169",
          "meeting_id": "TS3006a",
          "text": "Mm-hmm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.113",
          "meeting_id": "TS3006a",
          "text": "I mean , what functions do they have .",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.170",
          "meeting_id": "TS3006a",
          "text": "Mm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.114",
          "meeting_id": "TS3006a",
          "text": "Um especially what are their shortcomings ?",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.115",
          "meeting_id": "TS3006a",
          "text": "Are there any new functions uh which can be added to our product ?",
          "participant": "MTD024ME",
          "role": "ME"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.171",
          "meeting_id": "TS3006a",
          "text": "Mm-hmm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.A.dialog-act.vkaraisk.172",
          "meeting_id": "TS3006a",
          "text": "Mm-hmm .",
          "participant": "MTD021PM",
          "role": "PM"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.108",
          "participant": "MTD024ME",
          "role": "ME",
          "text": "Uh well"
        },
        {
          "da_id": "TS3006a.D.dialog-act.vkaraisk.116",
          "participant": "MTD024ME",
          "role": "ME",
          "text": "Um therefore we have to to do some internet search . For example for um well what kind of applications do current remote controls support , and what are f featur features of uh current and future televisions ?"
        }
