7d.json", "locator": "TS3007d.A.dialog-act.dharshi.139"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.152"}], "status": "adopted", "prior_context_needed": false, "related_items": []}, {"id": "TS3007d.sys.s.9", "text": "Teletext button will not be included on the remote; teletext will be accessed via menu.", "type": "decisions", "reference": [{"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.86"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.B.dialog-act.dharshi.102"}], "status": "adopted", "prior_context_needed": false, "related_items": []}, {"id": "TS3007d.sys.s.10", "text": "Adopt a single-curved design instead of a double-curved one to meet budget.", "type": "decisions", "reference": [{"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.C.dialog-act.dharshi.180"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.201"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.C.dialog-act.dharshi.184"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.B.dialog-act.dharshi.229"}], "status": "adopted", "prior_context_needed": false, "related_items": []}, {"id": "TS3007d.sys.s.11", "text": "The color/cost strategy is unsettled: standard covers and fruity colors vs white/gray; risk of mismatch with target groups.", "type": "problems", "reference": [{"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.C.dialog-act.dharshi.55"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.B.dialog-act.dharshi.47"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.B.dialog-act.dharshi.50"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.D.dialog-act.dharshi.29"}], "status": "open", "prior_context_needed": false, "related_items": []}, {"id": "TS3007d.sys.s.12", "text": "The PM will take the minutes, finish the end report, and place the end report on a storyboard. G_ and G_ will present the prototype. Decisions include placing buttons on the top and menu on the bottom, teletext access via the menu instead of a remote button, adopting a single-curved design to meet budget, and keeping costs under 12.5 Euro with redesign if needed. Problems outstanding: budget overrun risk with a 12.5 euro cap and eleven euros spent, and the digital pen is not user-friendly and does not work properly. The color/cost strategy is unsettled with potential mismatch for target groups.", "type": "abstract", "reference": [{"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.3"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.416"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.D.dialog-act.dharshi.367"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.427"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.428"}]}, {"id": "TS3007d.sys.s.13", "text": "G_ and G_ will present the prototype.", "type": "abstract", "reference": [{"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.5"}, {"source_type": "dialogue", "source": "ami-corpus/dialogueActs/TS3007d.json", "locator": "TS3007d.A.dialog-act.dharshi.24"}]}, {"id": "TS3007d.sys.s.14", "text": "Decisions include placing buttons on the top and menu on t