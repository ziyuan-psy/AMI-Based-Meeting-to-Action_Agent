    "observed_dialogue": [
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.132",
        "meeting_id": "ES2004b",
        "text": "when you read the the R_S_I_ issue again , repetitive strain injury , I don't think just moving your finger around on a small screen is going to deal with that enough ,",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.133",
        "meeting_id": "ES2004b",
        "text": "I think that is still a kind of a question mark issue how we deal with that .",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.134",
        "meeting_id": "ES2004b",
        "text": "Um , R_S_I_ tends to be caused by repetitive small movements .",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.C.dialog-act.s9553330.139",
        "meeting_id": "ES2004b",
        "text": "Yeah .",
        "participant": "MEE014",
        "role": "ID"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.135",
        "meeting_id": "ES2004b",
        "text": "I'm j I really can't get my head round this one ,",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.136",
        "meeting_id": "ES2004b",
        "text": "this may have to be postponed to a future meeting",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.C.dialog-act.s9553330.140",
        "meeting_id": "ES2004b",
        "text": "Yeah .",
        "participant": "MEE014",
        "role": "ID"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.140",
        "meeting_id": "ES2004b",
        "text": "Yeah .",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.B.dialog-act.s9553330.123",
        "meeting_id": "ES2004b",
        "text": "which is extremely expensive ,",
        "participant": "FEE013",
        "role": "PM"
      },
      {
        "da_id": "ES2004b.C.dialog-act.s9553330.146",
        "meeting_id": "ES2004b",
        "text": "but <disfmarker>",
        "participant": "MEE014",
        "role": "ID"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.152",
        "meeting_id": "ES2004b",
        "text": "I'm just thinking of budgetary issues too ,",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.153",
        "meeting_id": "ES2004b",
        "text": "for when it does get to the sort of broad scale marketing stage , we want to , you know , not waste money , not be profligate",
        "participant": "FEE016",
        "role": "ME"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.131",
        "participant": "FEE016",
        "role": "ME",
        "text": "I'm concerned ,"
      },
      {
        "da_id": "ES2004b.D.dialog-act.s9553330.137",
        "participant": "FEE016",
        "role": "ME",
        "text": "but it's something we should think about ."
      },
      {
        "da_id": "ES2004b.C.dialog-act.s9553330.145",
        "participant": "MEE014",
        "role": "ID",
        "text": "Yeah , speech recognition ,"
      },
