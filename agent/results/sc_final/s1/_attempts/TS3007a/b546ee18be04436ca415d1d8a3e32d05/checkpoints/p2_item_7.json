        "role": "PM"
      },
      {
        "da_id": "TS3007a.B.dialog-act.vkaraisk.84",
        "participant": "MTD027ID",
        "role": "UI",
        "text": "Um well"
      },
      {
        "da_id": "TS3007a.B.dialog-act.vkaraisk.86",
        "participant": "MTD027ID",
        "role": "UI",
        "text": "And my opinion is you should keep it as basic as possible . Uh <disfmarker>"
      },
      {
        "da_id": "TS3007a.D.dialog-act.vkaraisk.126",
        "participant": "MTD028ME",
        "role": "ME",
        "text": "Yeah . I think so ."
      }
    ],
