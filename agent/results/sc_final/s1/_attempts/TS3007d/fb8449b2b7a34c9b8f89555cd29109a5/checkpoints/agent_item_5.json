          "participant": "MTD025PM",
          "role": "PM",
          "text": "<vocalsound> Thank you J_ . <vocalsound>"
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.37",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "Not not too uh <disfmarker> yeah ."
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.39",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "Yeah , exactly ."
        },
        {
          "da_id": "TS3007d.A.dialog-act.dharshi.41",
          "participant": "MTD025PM",
          "role": "PM",
          "text": "Yeah , I can imagine that ."
        },
        {
          "da_id": "TS3007d.B.dialog-act.dharshi.43",
          "participant": "MTD027ID",
          "role": "UI",
          "text": "Yeah ."
        },
        {
          "da_id": "TS3007d.A.dialog-act.dharshi.112",
          "participant": "MTD025PM",
          "role": "PM",
          "text": "True . <vocalsound>"
