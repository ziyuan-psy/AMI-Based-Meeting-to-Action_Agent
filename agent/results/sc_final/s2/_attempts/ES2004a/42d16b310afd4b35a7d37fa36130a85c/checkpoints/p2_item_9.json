    "peer_items": [
      {
        "item_key": "ES2004a#0",
        "type": "actions",
        "text": "Prepare the next PowerPoint presentation."
      },
      {
        "item_key": "ES2004a#1",
        "type": "problems",
        "text": "Older generation usability is likely to be a problem regardless of design changes."
      },
      {
        "item_key": "ES2004a#2",
        "type": "problems",
        "text": "Remote-control usability and reliability concerns: design may be too complex due to many small buttons and unclear symbols; unsure about easy programmability; potential signal loss requiring re-programming."
      },
      {
        "item_key": "ES2004a#3",
        "type": "problems",
        "text": "No large-print option currently; consider adding; cost implications of design choices are unclear."
      },
      {
        "item_key": "ES2004a#4",
        "type": "decisions",
        "text": "Selling price is Seventeen Pounds."
      },
      {
        "item_key": "ES2004a#5",
        "type": "decisions",
        "text": "Market range international."
      },
      {
        "item_key": "ES2004a#6",
        "type": "decisions",
        "text": "The group proposed a profit target of fifty million Euros in the first year."
      },
      {
        "item_key": "ES2004a#7",
        "type": "problems",
        "text": "The Windows-like operating system observed on phones is confusing and could hinder usability."
      },
      {
        "item_key": "ES2004a#8",
        "type": "actions",
        "text": "All roster members will begin their individual tasks after this meeting."
      }
