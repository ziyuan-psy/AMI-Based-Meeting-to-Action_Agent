      "peer_items": [
        {
          "item_key": "ES2004d#0",
          "type": "actions",
          "text": "Provide recommendations for head office specifications."
        },
        {
          "item_key": "ES2004d#1",
          "type": "actions",
          "text": "All team members will provide individual ratings for the evaluation criteria."
        },
        {
          "item_key": "ES2004d#2",
          "type": "problems",
          "text": "Pricing currency is unclear; pricing may be in Euros or Dollars."
        },
        {
          "item_key": "ES2004d#3",
          "type": "problems",
          "text": "Projected profitability is uncertain because overheads remain to be accounted for beyond a stated 50 percent profit."
        },
        {
          "item_key": "ES2004d#4",
          "type": "problems",
          "text": "There is concern that the budget may not include all overhead costs, including salaries and heating."
        },
        {
          "item_key": "ES2004d#5",
          "type": "decisions",
          "text": "We decided to use a kinetic charger."
        },
        {
          "item_key": "ES2004d#6",
          "type": "decisions",
          "text": "Kinetic batteries will be placed in the top section near the hinge."
        },
        {
          "item_key": "ES2004d#7",
          "type": "decisions",
          "text": "Proceed to produce a prototype and bring it to market based on evaluation results."
        },
        {
          "item_key": "ES2004d#8",
          "type": "decisions",
          "text": "Rubber used in the casing will be counted as one unit in total cost."
        },
        {
          "item_key": "ES2004d#9",
          "type": "decisions",
          "text": "Interface will use push-buttons."
        },
        {
          "item_key": "ES2004d#10",
