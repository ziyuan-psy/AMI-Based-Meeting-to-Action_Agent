          "da_id": "TS3007d.B.dialog-act.dharshi.68",
          "meeting_id": "TS3007d",
          "text": "This is banana and mango , not not purple or p orange and yellow .",
          "participant": "MTD027ID",
          "role": "UI"
        },
        {
          "da_id": "TS3007d.C.dialog-act.dharshi.55",
          "meeting_id": "TS3007d",
          "text": "<vocalsound> And and for colours , we we figured starting with basic colours like uh white or metallic grey .",
          "participant": "MTD026UID",
          "role": "ID"
        },
        {
          "da_id": "TS3007d.C.dialog-act.dharshi.56",
          "meeting_id": "TS3007d",
          "text": "Those are the technological colours actually ,",
          "participant": "MTD026UID",
          "role": "ID"
        },
        {
          "da_id": "TS3007d.B.dialog-act.dharshi.110",
          "meeting_id": "TS3007d",
          "text": "Black and red . <vocalsound>",
          "participant": "MTD027ID",
          "role": "UI"
        },
        {
          "da_id": "TS3007d.B.dialog-act.dharshi.138",
          "meeting_id": "TS3007d",
          "text": "Um I would call uh <disfmarker> choose two ,",
          "participant": "MTD027ID",
          "role": "UI"
        },
        {
          "da_id": "TS3007d.B.dialog-act.dharshi.139",
          "meeting_id": "TS3007d",
          "text": "'cause we decided not to make two f uh fresh colours , as it would not <gap> .",
          "participant": "MTD027ID",
          "role": "UI"
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.37",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "Not not too uh <disfmarker> yeah ."
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.39",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "Yeah , exactly ."
        },
        {
          "da_id": "TS3007d.A.dialog-act.dharshi.41",
          "participant": "MTD025PM",
          "role": "PM",
          "text": "Yeah , I can imagine that ."
        },
        {
          "da_id": "TS3007d.B.dialog-act.dharshi.43",
          "participant": "MTD027ID",
          "role": "UI",
          "text": "Yeah ."
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.111",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "<vocalsound>"
        },
        {
          "da_id": "TS3007d.A.dialog-act.dharshi.94",
          "participant": "MTD025PM",
          "role": "PM",
          "text": "<vocalsound> Thank you J_ . <vocalsound>"
        },
        {
          "da_id": "TS3007d.A.dialog-act.dharshi.112",
          "participant": "MTD025PM",
          "role": "PM",
          "text": "True . <vocalsound>"
        },
        {
          "da_id": "TS3007d.C.dialog-act.dharshi.127",
          "participant": "MTD026UID",
          "role": "ID",
          "text": "<vocalsound>"
        },
        {
          "da_id": "TS3007d.D.dialog-act.dharshi.144",
          "participant": "MTD028ME",
          "role": "ME",
          "text": "Yeah , yeah , not too flashy ."
