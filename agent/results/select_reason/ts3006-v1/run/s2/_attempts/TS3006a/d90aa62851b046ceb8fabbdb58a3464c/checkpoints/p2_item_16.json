    "observed_dialogue": [
      {
        "da_id": "TS3006a.B.dialog-act.vkaraisk.96",
        "meeting_id": "TS3006a",
        "text": "I I think we have first to start with the basic functions",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.159",
        "meeting_id": "TS3006a",
        "text": "Yeah",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006a.B.dialog-act.vkaraisk.97",
        "meeting_id": "TS3006a",
        "text": "and we can uh expand them .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.158",
        "meeting_id": "TS3006a",
        "text": "well",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.228",
        "meeting_id": "TS3006a",
        "text": "You can always add a few <disfmarker>",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.160",
        "meeting_id": "TS3006a",
        "text": "like l li like some like some some remotes who are out there , which I know , there's one button which is very easy to switch between devices .",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.229",
        "meeting_id": "TS3006a",
        "text": "Yeah .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.161",
        "meeting_id": "TS3006a",
        "text": "So you can switch to your video",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.162",
        "meeting_id": "TS3006a",
        "text": "and then the same buttons control your video .",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006a.C.dialog-act.vkaraisk.139",
        "meeting_id": "TS3006a",
        "text": "Alright .",
        "participant": "MTD022ID",
        "role": "ID"
      },
      {
        "da_id": "TS3006a.B.dialog-act.vkaraisk.101",
        "meeting_id": "TS3006a",
        "text": "it it has yeah it has to be user-friendly .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006a.B.dialog-act.vkaraisk.102",
        "meeting_id": "TS3006a",
        "text": "So it's hasn't <gap> <disfmarker> it's <disfmarker> yeah .",
        "participant": "MTD023UID",
        "role": "UI"
      },
      {
        "da_id": "TS3006a.B.dialog-act.vkaraisk.95",
        "participant": "MTD023UID",
        "role": "UI",
        "text": "Yeah ."
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.231",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "Hmm ,"
      },
      {
        "da_id": "TS3006a.D.dialog-act.vkaraisk.174",
        "participant": "MTD024ME",
        "role": "ME",
        "text": "Yeah ."
      },
      {
        "da_id": "TS3006a.A.dialog-act.vkaraisk.248",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "<vocalsound> Th the least amount of functions possible"
      }
    ],
    "peer_items": [
      {
        "item_key": "TS3006a#0",
        "type": "actions",
        "text": "The Industrial Designer will produce a working design."
      },
      {
        "item_key": "TS3006a#1",
        "type": "actions",
        "text": "The User Interface Designer will specify the technical functions."
      },
      {
        "item_key": "TS3006a#2",
        "type": "actions",
        "text": "The Marketing Expert will come up with user requirements."
      },
      {
        "item_key": "TS3006a#3",
        "type": "actions",
        "text": "PM will summarize the discussed items and put them in the project folder."
      },
      {
        "item_key": "TS3006a#4",
        "type": "actions",
        "text": "The Industrial Designer will work on the conceptual design."
      },
      {
        "item_key": "TS3006a#5",
        "type": "actions",
        "text": "PM will defend the design in the final presentation."
      },
      {
        "item_key": "TS3006a#6",
        "type": "actions",
        "text": "The Marketing Expert will perform internet research and interview current and future users to identify user requirements."
      },
      {
        "item_key": "TS3006a#7",
        "type": "actions",
        "text": "The Industrial Designer will put the components into the design."
      },
      {
        "item_key": "TS3006a#8",
        "type": "actions",
        "text": "The Industrial Designer will add his ideas to the document for discussion at the next meeting."
      },
      {
        "item_key": "TS3006a#9",
        "type": "problems",
        "text": "Unclear time available to draw; risk of taking forever."
      },
      {
        "item_key": "TS3006a#10",
        "type": "problems",
        "text": "ID(MTD022ID): <vocalsound> I don't know how much preparation you guys did ,"
      },
      {
        "item_key": "TS3006a#11",
        "type": "decisions",
        "text": "PM(MTD021PM): At the end of the day we should have a prototype drawn up ."
      },
      {
        "item_key": "TS3006a#12",
        "type": "decisions",
        "text": "PM(MTD021PM): We can sell them at twenty five Euros ."
      },
      {
        "item_key": "TS3006a#13",
        "type": "decisions",
        "text": "the production cost should be the half of the selling price ."
      },
      {
        "item_key": "TS3006a#14",
        "type": "decisions",
        "text": "PM(MTD021PM): Do we only have to to do uh phase one , the functional design uh ?"
      },
      {
        "item_key": "TS3006a#15",
        "type": "decisions",
        "text": "PM(MTD021PM): We could just start with the assumption that's only for TV and video ."
      }
    ],
