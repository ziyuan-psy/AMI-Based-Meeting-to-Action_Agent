      "peer_items": [
        {
          "item_key": "TS3006b#0",
          "type": "actions",
          "text": "The ME will work on the look-and-feel of the remote and add a screen on top."
        },
        {
          "item_key": "TS3006b#1",
          "type": "actions",
          "text": "The UI Designer will compile a list of functions to be displayed on the LCD screen and design a multi-page LCD menu with layers."
        },
        {
          "item_key": "TS3006b#2",
          "type": "actions",
          "text": "The User Interface Designer will make maps with all the data gathered."
        },
        {
          "item_key": "TS3006b#3",
          "type": "actions",
          "text": "PM will write the meeting minutes."
        },
        {
          "item_key": "TS3006b#4",
          "type": "decisions",
          "text": "Two groups of functions: simple for public and advanced for experienced users."
        },
        {
          "item_key": "TS3006b#5",
          "type": "decisions",
          "text": "Target group defined as users aged sixteen to forty."
        },
        {
          "item_key": "TS3006b#6",
          "type": "decisions",
          "text": "There must be a screen on the remote."
        },
        {
          "item_key": "TS3006b#7",
          "type": "decisions",
          "text": "The design will implement two menus: a button menu and an LCD options menu."
        },
        {
          "item_key": "TS3006b#8",
          "type": "decisions",
          "text": "Menu should be organized into two groups: the display group and the basic functions group, with a dividing line."
        },
        {
          "item_key": "TS3006b#9",
          "type": "decisions",
          "text": "There will be one OK button and one navigation button, with a back button; the navigation button will be multifunctional for channel/volume."
        }
      ],
