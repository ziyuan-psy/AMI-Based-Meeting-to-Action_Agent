        "da_id": "IS1008a.C.dialog-act.s9553330.38",
        "meeting_id": "IS1008a",
        "text": "Uh <vocalsound> are there other people who will be contributing to the plan ?",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.71",
        "meeting_id": "IS1008a",
        "text": "Yes , of course ,",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.73",
        "meeting_id": "IS1008a",
        "text": "So , who are the people you need uh from the marketing or uh the technical side or uh the administration point of view , okay , to add in any documentation , or some technical point of view ,",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.74",
        "meeting_id": "IS1008a",
        "text": "so just let me know so I can uh coordinate all the teams .",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.40",
        "meeting_id": "IS1008a",
        "text": "Okay , I'll get back to you on that .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.70",
        "participant": "MIO086",
        "role": "PM",
        "text": "then we can have the further discussion again ."
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.72",
        "participant": "MIO086",
        "role": "PM",
        "text": "if you need some help , uh so let me know ."
      },
      {
        "da_id": "IS1008a.C.dialog-act.s9553330.39",
        "participant": "FIE073",
        "role": "ID",
        "text": "<vocalsound>"
      },
      {
        "da_id": "IS1008a.A.dialog-act.s9553330.75",
        "participant": "MIO086",
        "role": "PM",
        "text": "Yes ."
      }
    ],
    "peer_items": [
