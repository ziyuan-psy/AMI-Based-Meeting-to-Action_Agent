      "peer_items": [
        {
          "item_key": "TS3006b#0",
          "type": "actions",
          "text": "PM asked UI designer to design a menu for all these function"
        },
        {
          "item_key": "TS3006b#1",
          "type": "actions",
          "text": "PM will design the basic function menu for the LCD screen"
        },
        {
          "item_key": "TS3006b#2",
          "type": "actions",
          "text": "Design a multi-page LCD screen menu"
        },
        {
          "item_key": "TS3006b#3",
          "type": "decisions",
          "text": "Target users under forty and balance functionality with ease"
        },
        {
          "item_key": "TS3006b#4",
          "type": "decisions",
          "text": "Include LCD screen and speech recognition to appeal to users under forty while keeping classic functions"
        },
        {
          "item_key": "TS3006b#5",
          "type": "decisions",
          "text": "We will have two groups of functions: simple for the general public and advanced for younger users"
        },
        {
          "item_key": "TS3006b#6",
          "type": "decisions",
          "text": "Provide a screen-based option to configure advanced features via a clear menu while keeping basic functions on the device"
        },
        {
          "item_key": "TS3006b#7",
          "type": "decisions",
          "text": "Place the screen on top in the layout and create a visual separation (line) between the two groups"
        },
        {
          "item_key": "TS3006b#8",
          "type": "actions",
          "text": "Create maps with all the data we gathered"
        },
        {
          "item_key": "TS3006b#9",
          "type": "actions",
          "text": "Organize the data into three categories"
        },
        {
          "item_key": "TS3006b#10",
          "type": "actions",
          "text": "Group functions into two groups: display and basic functions"
        },
        {
          "item_key": "TS3006b#11",
          "type": "actions",
          "text": "The ID will design the layout of the remote"
        },
        {
          "item_key": "TS3006b#12",
          "type": "problems",
          "text": "User feedback indicates dislike of look-and-feel of current remotes"
        },
        {
          "item_key": "TS3006b#13",
          "type": "problems",
          "text": "Current remotes do not match operating behaviour expected by users"
        },
        {
          "item_key": "TS3006b#14",
          "type": "problems",
          "text": "Remotes are often lost in the room"
        }
