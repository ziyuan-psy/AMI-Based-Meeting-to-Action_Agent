      "peer_items": [
        {
          "item_key": "IS1008a#0",
          "type": "actions",
          "text": "Ed will provide a written project plan by the next meeting, including functional and technical design, required team size, timeframe, budget, and marketing plan."
        },
        {
          "item_key": "IS1008a#1",
          "type": "actions",
          "text": "PM will send a copy of the slides to attendees after the meeting."
        },
        {
          "item_key": "IS1008a#2",
          "type": "actions",
          "text": "UI will start determining the functional design."
        },
        {
          "item_key": "IS1008a#3",
          "type": "actions",
          "text": "Industrial designer will identify which people from marketing, technical, and administration will contribute to the plan."
        },
        {
          "item_key": "IS1008a#4",
          "type": "actions",
          "text": "The UI will CC Ed on all discussions or documents that are passed around."
        },
        {
          "item_key": "IS1008a#5",
          "type": "actions",
          "text": "The UI will copy PM on all mails and discussions."
        },
        {
          "item_key": "IS1008a#6",
          "type": "actions",
          "text": "Ed and Christine will develop the sales plan together, including cost considerations."
        },
        {
          "item_key": "IS1008a#7",
          "type": "actions",
          "text": "UI will interact with Christine to ensure usability and user acceptance testing."
        },
        {
          "item_key": "IS1008a#8",
          "type": "problems",
          "text": "There is confusion about the project goal and deliverables, with expectations that the project is for a monitor rather than a remote control."
        },
        {
          "item_key": "IS1008a#9",
          "type": "problems",
          "text": "No functional or technical design exists yet for the project."
        },
        {
          "item_key": "IS1008a#10",
          "type": "problems",
          "text": "Lack of a formal written plan prevents going to management for funding."
        }
