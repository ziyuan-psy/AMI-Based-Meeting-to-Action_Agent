      "observed_dialogue": [
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.59",
          "meeting_id": "IS1008a",
          "text": "Yeah , but uh I need something in the writing ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.60",
          "meeting_id": "IS1008a",
          "text": "so like uh what's your functional design , what's your technical design , and uh how many people you need for this project , and what's the time frame you're looking , okay , and what is the budget , maybe uh initial budget you're looking , okay , and uh how is going to the market , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.34",
          "meeting_id": "IS1008a",
          "text": "Mm-hmm .",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.35",
          "meeting_id": "IS1008a",
          "text": "Mm-hmm .",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.61",
          "meeting_id": "IS1008a",
          "text": "so you've you've had to meet with the marketing team and how they're going to market and what are the marketing strategic plan , okay ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.62",
          "meeting_id": "IS1008a",
          "text": "when are you going to introduce , okay , and by the time you introduce the product and uh you know there there would be a competition ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.63",
          "meeting_id": "IS1008a",
          "text": "okay , so I need some kind of uh uh the plan in the writing from you .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.36",
          "meeting_id": "IS1008a",
          "text": "<vocalsound> And when would you like that ?",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.65",
          "meeting_id": "IS1008a",
          "text": "B as soon as possible .",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.37",
          "meeting_id": "IS1008a",
          "text": "<vocalsound> Uh well if uh if we have enough time uh then d do you think um two weeks is a <disfmarker> is close enough ?",
          "participant": "FIE073",
          "role": "ID"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.66",
          "meeting_id": "IS1008a",
          "text": "Yes I think uh that would be good ,",
          "participant": "MIO086",
          "role": "PM"
        },
        {
          "da_id": "IS1008a.C.dialog-act.s9553330.33",
          "participant": "FIE073",
          "role": "ID",
          "text": "If um if I run into any problems in my other projects it might be six months ."
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.64",
          "participant": "MIO086",
          "role": "PM",
          "text": "Okay , and it's po"
        },
        {
          "da_id": "IS1008a.A.dialog-act.s9553330.67",
          "participant": "MIO086",
          "role": "PM",
          "text": "because I need to go to the management and uh tell them what we are going to do , and uh what cost is , okay , and what's the time frame and what's the project plan ,"
        }
      ],
      "peer_items": [
        {
          "item_key": "IS1008a#0",
          "type": "actions",
          "text": "Ed will provide a written project plan by the next meeting, including functional and technical design, required team size, timeframe, budget, and marketing plan."
        },
        {
          "item_key": "IS1008a#1",
          "type": "actions",
          "text": "PM will send a copy of the slides to attendees after the meeting."
        },
        {
          "item_key": "IS1008a#2",
          "type": "actions",
          "text": "UI will start determining the functional design."
        },
        {
          "item_key": "IS1008a#3",
          "type": "actions",
          "text": "Industrial designer will identify which people from marketing, technical, and administration will contribute to the plan."
        },
        {
          "item_key": "IS1008a#4",
          "type": "actions",
          "text": "The UI will CC Ed on all discussions or documents that are passed around."
        },
        {
          "item_key": "IS1008a#5",
          "type": "actions",
          "text": "The UI will copy PM on all mails and discussions."
        },
        {
          "item_key": "IS1008a#6",
          "type": "actions",
          "text": "Ed and Christine will develop the sales plan together, including cost considerations."
        },
        {
          "item_key": "IS1008a#7",
          "type": "actions",
          "text": "UI will interact with Christine to ensure usability and user acceptance testing."
        },
        {
          "item_key": "IS1008a#8",
          "type": "problems",
          "text": "There is confusion about the project goal and deliverables, with expectations that the project is for a monitor rather than a remote control."
        },
        {
          "item_key": "IS1008a#9",
          "type": "problems",
          "text": "No functional or technical design exists yet for the project."
        },
        {
          "item_key": "IS1008a#10",
          "type": "problems",
          "text": "Lack of a formal written plan prevents going to management for funding."
        },
        {
          "item_key": "IS1008a#11",
          "type": "decisions",
          "text": "The product scope is a remote control for television."
        },
        {
          "item_key": "IS1008a#12",
          "type": "decisions",
          "text": "The project plan will be delivered by the next meeting."
        },
        {
          "item_key": "IS1008a#13",
          "type": "decisions",
          "text": "A written project plan including functional and technical designs will be produced within two weeks."
        }
      ],
