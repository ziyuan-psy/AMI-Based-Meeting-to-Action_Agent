        {
          "item_key": "IS1008a#5",
          "type": "decisions",
          "text": "Product to develop is a remote control for television with a user-friendly design."
        },
        {
          "item_key": "IS1008a#6",
          "type": "decisions",
          "text": "Written plan produced by plan owner within two weeks for presentation to management."
        },
        {
          "item_key": "IS1008a#7",
          "type": "actions",
          "text": "Conduct market/competitor research on remote controls."
