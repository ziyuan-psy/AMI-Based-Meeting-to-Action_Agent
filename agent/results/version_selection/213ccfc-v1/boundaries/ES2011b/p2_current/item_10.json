        "item_key": "ES2011b#1",
        "type": "problems",
        "text": "An acronym 'R_S_I_' used in the notes is unclear; the team needs clarification on its meaning."
      },
      {
        "item_key": "ES2011b#2",
        "type": "actions",
        "text": "The PM will upload the meeting minutes to the shared documents folder and have them up for the next meeting."
      },
      {
        "item_key": "ES2011b#3",
        "type": "problems",
        "text": "There are conflicting inputs on the target group: nineteen-to-thirty-five vs teenagers and young professionals."
      },
      {
        "item_key": "ES2011b#4",
        "type": "actions",
        "text": "All participants will finish their questionnaire after this meeting and bring new ideas to the next meeting."
      },
      {
        "item_key": "ES2011b#5",
        "type": "decisions",
        "text": "The remote will be used only for television, with no extra internet features; just the remote and the television."
      },
      {
        "item_key": "ES2011b#6",
        "type": "problems",
        "text": "Uncertainty about cross-national standardization of VCR remotes, requiring region-specific button sets."
      },
      {
        "item_key": "ES2011b#7",
        "type": "decisions",
        "text": "The branding should incorporate our corporate image into the product, aiming for a fashion-forward electronics design using silver and yellow colours."
      },
      {
        "item_key": "ES2011b#8",
        "type": "actions",
        "text": "The PM will check the new project requirements and update the team at the next meeting."
      },
      {
        "item_key": "ES2011b#9",
        "type": "decisions",
        "text": "The remote will support two basic functions: inputting a channel/volume setting, and a location function, with location signals transmitted via radio (not infrared) to support no-line-of-sight, and the location finder can be activated via a button on the TV or on the wall."
      }
