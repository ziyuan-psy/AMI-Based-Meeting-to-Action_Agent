    "peer_items": [
      {
        "item_key": "ES2011c#0",
        "type": "actions",
        "text": "UI and ME will play with play-dough to prototype the look and feel of the design and the user interface."
      },
      {
        "item_key": "ES2011c#1",
        "type": "decisions",
        "text": "We will not include D_V_D_ (DVD) features in the remote design."
      },
      {
        "item_key": "ES2011c#2",
        "type": "problems",
        "text": "There is uncertainty about whether to include a screen, given ambiguous use and the potential cost, with debate on its necessity versus a wheel-based control."
      },
      {
        "item_key": "ES2011c#3",
        "type": "decisions",
        "text": "We will pursue a fashion electronics approach with a fruit-and-vegetable motif, including the decision on whether the motif is printed or the remote resembles a fruit."
      },
      {
        "item_key": "ES2011c#4",
        "type": "decisions",
        "text": "The menu system should reside inside the TV, not inside the remote."
      },
      {
        "item_key": "ES2011c#5",
        "type": "decisions",
        "text": "For now we will do two prototypes of the product."
      },
      {
        "item_key": "ES2011c#6",
        "type": "decisions",
        "text": "The group proposed to use batteries as the energy source for the product, with the batteries placed right under the plastic case."
      }
    ],
