      "related_items": []
    },
    {
      "id": "ES2011c.sys.s.4",
      "text": "The menu system should reside inside the TV, not inside the remote.",
      "type": "decisions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011c.json",
          "locator": "ES2011c.B.dialog-act.dharshi.70"
        }
      ],
      "status": "adopted",
      "prior_context_needed": false,
      "related_items": []
    },
    {
      "id": "ES2011c.sys.s.5",
      "text": "For now we will do two prototypes of the product.",
      "type": "decisions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011c.json",
          "locator": "ES2011c.D.dialog-act.dharshi.126"
        }
      ],
      "status": "adopted",
      "prior_context_needed": false,
      "related_items": []
    },
    {
      "id": "ES2011c.sys.s.6",
      "text": "The group proposed to use batteries as the energy source for the product, with the batteries placed right under the plastic case.",
      "type": "decisions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011c.json",
          "locator": "ES2011c.A.dialog-act.dharshi.198"
