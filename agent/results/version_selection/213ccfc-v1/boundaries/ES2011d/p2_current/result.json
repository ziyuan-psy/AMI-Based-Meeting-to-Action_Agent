    {
      "id": "ES2011d.sys.s.1",
      "text": "We decided on batteries, and the regular chip would be necessary for the more advanced iPod-like button.",
      "type": "decisions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011d.json",
          "locator": "ES2011d.A.dialog-act.dharshi.31"
        },
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011d.json",
          "locator": "ES2011d.A.dialog-act.dharshi.32"
        }
      ],
      "status": "adopted",
      "prior_context_needed": false,
      "related_items": []
    },
    {
      "id": "ES2011d.sys.s.2",
      "text": "It's been a little bit difficult to ensure that it's hand-holdable and easy to use, without being too big.",
      "type": "problems",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/ES2011d.json",
