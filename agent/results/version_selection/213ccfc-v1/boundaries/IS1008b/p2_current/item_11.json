    "peer_items": [
      {
        "item_key": "IS1008b#0",
        "type": "decisions",
        "text": "The teletext feature is outmoded and should not be considered in the new project design."
      },
      {
        "item_key": "IS1008b#1",
        "type": "problems",
        "text": "Financial objectives are unclear or missing with no consensus on a revenue target, and there is pricing risk as the proposed price point may not align with market expectations or willingness to pay."
      },
      {
        "item_key": "IS1008b#2",
        "type": "actions",
        "text": "PM MIO086 will coordinate with Intel or IBM to obtain technical backup for speech recognition and related design work."
      },
      {
        "item_key": "IS1008b#3",
        "type": "decisions",
        "text": "The remote control should be used only for the TV."
      },
      {
        "item_key": "IS1008b#4",
        "type": "problems",
        "text": "There are usability and speech recognition challenges: 35% say speech recognition is too difficult to use; 50% say they can't find the remote half the time; ambient noise and on-screen dialogue can cause misinterpretation of commands requiring robust filtering; training for voice commands may be time-consuming for users; speech recognition could impact battery life, necessitating wireless charging or solar cells; and there is uncertainty whether speech recognition should rely on one-word commands or allow longer phrases."
      },
      {
        "item_key": "IS1008b#5",
        "type": "actions",
        "text": "PM MIO086 will help Christine identify and contact technical companies to assist in slimming the design."
      },
      {
        "item_key": "IS1008b#6",
        "type": "actions",
        "text": "ID(FIE073) will work on the components concept."
      },
      {
        "item_key": "IS1008b#7",
        "type": "problems",
        "text": "No final decision on which features to include has been reached; the group is debating whether to start with all features or prune later, and remote UI issues include too many buttons and unclear labels along with concerns about findability and search capability; time pressure ended the discussion with important decisions unresolved."
      },
      {
        "item_key": "IS1008b#8",
        "type": "decisions",
        "text": "The group proposed setting a target to achieve at least 50 million Euro in revenue, and noted that there is currently no explicit financial objective or consensus on the revenue target."
      },
      {
        "item_key": "IS1008b#9",
        "type": "actions",
        "text": "FIE073 will identify user requirements."
      },
      {
        "item_key": "IS1008b#10",
        "type": "decisions",
        "text": "The management said they want something new and do not want to continue with certain existing facilities."
      }
