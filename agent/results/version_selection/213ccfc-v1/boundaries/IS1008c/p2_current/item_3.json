    "observed_dialogue": [
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.29",
        "meeting_id": "IS1008c",
        "text": "question , uh , what's mean exactly , advanced chip on print ?",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008c.C.dialog-act.s9553330.80",
        "meeting_id": "IS1008c",
        "text": "Uh I could find out more about that uh before the next fi next meeting .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.32",
        "meeting_id": "IS1008c",
        "text": "Yeah ,",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.33",
        "meeting_id": "IS1008c",
        "text": "is it means it's on the <disfmarker> yeah",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.34",
        "meeting_id": "IS1008c",
        "text": "is it on a micro-proc micro-processor based or uh <disfmarker>",
        "participant": "MIO086",
        "role": "PM"
      },
      {
        "da_id": "IS1008c.C.dialog-act.s9553330.81",
        "meeting_id": "IS1008c",
        "text": "<vocalsound>",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008c.C.dialog-act.s9553330.82",
        "meeting_id": "IS1008c",
        "text": "I don't know ,",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008c.C.dialog-act.s9553330.83",
        "meeting_id": "IS1008c",
        "text": "but I'll find out more at our next meeting .",
        "participant": "FIE073",
        "role": "ID"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.28",
        "participant": "MIO086",
        "role": "PM",
        "text": "Yes , uh <gap>"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.30",
        "participant": "MIO086",
        "role": "PM",
        "text": "What's the meaning of that ?"
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.31",
        "participant": "MIO086",
        "role": "PM",
        "text": "Mm-hmm ."
      },
      {
        "da_id": "IS1008c.A.dialog-act.s9553330.35",
        "participant": "MIO086",
        "role": "PM",
        "text": "Okay , tha that would be great ,"
      }
    ],
