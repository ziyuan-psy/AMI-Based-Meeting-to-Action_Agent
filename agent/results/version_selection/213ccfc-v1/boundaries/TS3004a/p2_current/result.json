    {
      "id": "TS3004a.sys.s.2",
      "text": "The remote control is likely to be dropped and broken due to frequent handling, raising durability concerns.",
      "type": "problems",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/TS3004a.json",
