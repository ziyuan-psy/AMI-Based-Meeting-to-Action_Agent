    },
    {
      "id": "TS3004a.sys.s.3",
      "text": "The product will be a universal remote control capable of operating TV and other devices (including VCR and DVD) and will be designed as a black device.",
      "type": "decisions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/TS3004a.json",
