    },
    {
      "id": "TS3004a.sys.s.6",
      "text": "A touchscreen on the remote could be fragile and not kid-friendly, raising durability and usability concerns.",
      "type": "problems",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/TS3004a.json",
