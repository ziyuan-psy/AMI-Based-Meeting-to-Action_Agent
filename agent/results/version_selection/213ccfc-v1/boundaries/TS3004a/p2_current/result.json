    {
      "id": "TS3004a.sys.s.5",
      "text": "A calculation is to be made of how many units need to be sold to achieve fifty million euros in profit.",
      "type": "actions",
      "reference": [
        {
          "source_type": "dialogue",
          "source": "ami-corpus/dialogueActs/TS3004a.json",
          "locator": "TS3004a.A.dialog-act.vkaraisk.196"
