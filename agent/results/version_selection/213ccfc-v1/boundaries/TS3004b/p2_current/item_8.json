    "peer_items": [
      {
        "item_key": "TS3004b#0",
        "type": "decisions",
        "text": "The product will be a TV remote control only."
      },
      {
        "item_key": "TS3004b#1",
        "type": "problems",
        "text": "Ambiguity about product scope: universal remote vs TV remote."
      },
      {
        "item_key": "TS3004b#2",
        "type": "problems",
        "text": "Feasibility: the proposed price around 25 EUR may be too high given production cost of 12.5 EUR."
      },
      {
        "item_key": "TS3004b#3",
        "type": "decisions",
        "text": "No LCD and no speech recognition due to budget constraints."
      },
      {
        "item_key": "TS3004b#4",
        "type": "decisions",
        "text": "Pursue an elderly-friendly, simple remote design with large buttons, standard conventions, top 10% of buttons on the top for reachability, and no two-level navigation."
      },
      {
        "item_key": "TS3004b#5",
        "type": "problems",
        "text": "There is a tight timeline to get the product to market."
      },
      {
        "item_key": "TS3004b#6",
        "type": "decisions",
        "text": "Skip teletext option; teletext is outdated."
      },
      {
        "item_key": "TS3004b#7",
        "type": "decisions",
        "text": "Lighting indicators: red LED indicator and a light under the numbers and keypad that lights briefly when a button is pressed."
      }
