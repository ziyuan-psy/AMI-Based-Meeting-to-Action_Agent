    "observed_dialogue": [
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.376",
        "meeting_id": "TS3006b",
        "text": "yh we have lunch break ,",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.378",
        "meeting_id": "TS3006b",
        "text": "and I have to write very fast to make the minich min minutes .",
        "participant": "MTD021PM",
        "role": "PM"
      },
      {
        "da_id": "TS3006b.D.dialog-act.dharshi.426",
        "meeting_id": "TS3006b",
        "text": "Yeah .",
        "participant": "MTD024ME",
        "role": "ME"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.375",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "it's not because I don't like you but <disfmarker>"
      },
      {
        "da_id": "TS3006b.C.dialog-act.dharshi.202",
        "participant": "MTD022ID",
        "role": "ID",
        "text": "Already ."
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.377",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "and then we can work for thirty minutes ,"
      },
      {
        "da_id": "TS3006b.A.dialog-act.dharshi.379",
        "participant": "MTD021PM",
        "role": "PM",
        "text": "And then uh we'll see <disfmarker>"
      }
    ],
    "peer_items": [
      {
        "item_key": "TS3006b#0",
        "type": "actions",
        "text": "The UI Designer will design the LCD screen menu for all functions."
      },
      {
        "item_key": "TS3006b#1",
        "type": "decisions",
        "text": "Teletext functionality will not be included in the remote because it is outdated."
      },
      {
        "item_key": "TS3006b#2",
        "type": "decisions",
        "text": "The target user group will be users below forty."
      },
      {
        "item_key": "TS3006b#3",
        "type": "problems",
        "text": "Ownership and accountability of decisions are unclear due to delegation phrases with no explicit owner."
      },
      {
        "item_key": "TS3006b#4",
        "type": "decisions",
        "text": "The corporate identity should be clear in the remote design, with the corporate logo placed on the top-left, aligned with the screen."
      },
      {
        "item_key": "TS3006b#5",
        "type": "decisions",
        "text": "The product will be designed to control only one device."
      },
      {
        "item_key": "TS3006b#6",
        "type": "decisions",
        "text": "Place the screen on the top of the remote, adopt the look-and-feel of the left example, and integrate speech recognition with basic functions placed on the device and advanced features hidden behind a screen menu."
      },
      {
        "item_key": "TS3006b#7",
        "type": "decisions",
        "text": "Include an equaliser with treble and bass, a mono/stereo option for the sound output, and pitch control."
      },
      {
        "item_key": "TS3006b#8",
        "type": "actions",
        "text": "The UI designer will make a list of the functions to be included on the screen."
      },
      {
        "item_key": "TS3006b#9",
        "type": "actions",
        "text": "The UI designer will create maps with all the data we have gathered."
      }
    ],
