{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2 check outcomes and clarification requests, version 1",
  "type": "object",
  "properties": {
    "p2": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "run_id": {
          "type": "string"
        },
        "meeting_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      },
      "required": [
        "format_version",
        "run_id",
        "meeting_id",
        "enabled",
        "items"
      ],
      "additionalProperties": false
    },
    "clarifications": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "run_id": {
          "type": "string"
        },
        "meeting_id": {
          "type": "string"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      },
      "required": [
        "format_version",
        "run_id",
        "meeting_id",
        "requests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "p2",
    "clarifications"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "uncertain",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "da_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "da_id",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "enum": [
              "statement",
              "owner",
              "deadline",
              "status",
              "related_items"
            ]
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentSelection"
          }
        }
      },
      "required": [
        "result",
        "reason",
        "quotes",
        "fields"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "item_key": {
          "type": "string"
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "enum": [
            "statement",
            "owner",
            "deadline",
            "status",
            "related_items"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "item_text": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_da_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "available_evidence_da_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status": {
          "const": "open"
        },
        "termination_reason": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "item_key",
        "record_id",
        "field",
        "question",
        "item_text",
        "reason",
        "evidence_da_ids",
        "available_evidence_da_ids",
        "status",
        "termination_reason"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "item_key": {
          "type": "string"
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_type": {
          "enum": [
            "actions",
            "decisions",
            "problems"
          ]
        },
        "item_text": {
          "type": "string"
        },
        "state": {
          "enum": [
            "accepted",
            "pending"
          ]
        },
        "recordable": {
          "type": "boolean"
        },
        "fields": {
          "type": "object"
        },
        "draft_fields": {
          "type": "object"
        },
        "checks": {
          "type": "object",
          "properties": {
            "statement": {
              "$ref": "#/$defs/finding"
            },
            "owner": {
              "$ref": "#/$defs/finding"
            },
            "deadline": {
              "$ref": "#/$defs/finding"
            },
            "status": {
              "$ref": "#/$defs/finding"
            },
            "conflict": {
              "$ref": "#/$defs/finding"
            },
            "relation": {
              "$ref": "#/$defs/relationFinding"
            }
          },
          "required": [
            "statement",
            "owner",
            "deadline",
            "status",
            "conflict",
            "relation"
          ],
          "additionalProperties": false
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "enum": [
              "statement",
              "owner",
              "deadline",
              "status",
              "related_items"
            ]
          },
          "uniqueItems": true
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "lookups": {
          "type": "integer",
          "minimum": 0
        },
        "termination_reason": {
          "type": "string"
        },
        "clarifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "observed_evidence_da_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "relation_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "prior_item_id",
              "relation",
              "state",
              "before",
              "after",
              "prior_quotes",
              "current_quotes",
              "changed_fields",
              "reason"
            ],
            "properties": {
              "state": {
                "enum": [
                  "supported",
                  "pending"
                ]
              },
              "prior_item_id": {
                "type": "string"
              },
              "relation": {
                "enum": [
                  "continues",
                  "updates",
                  "replaces",
                  "cancels",
                  "completes",
                  "resolves",
                  "reopens"
                ]
              },
              "changed_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "text",
                    "scope",
                    "owner",
                    "deadline",
                    "status"
                  ]
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              },
              "prior_quotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "da_id": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "da_id",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "current_quotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "da_id": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "da_id",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "initial_context": {
          "type": "object"
        },
        "observed_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentPassage"
          }
        },
        "document_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentEvidence"
          }
        }
      },
      "required": [
        "item_key",
        "record_id",
        "item_type",
        "item_text",
        "state",
        "recordable",
        "fields",
        "draft_fields",
        "checks",
        "unresolved_fields",
        "history",
        "lookups",
        "termination_reason",
        "clarifications",
        "observed_evidence_da_ids"
      ],
      "additionalProperties": false
    },
    "relationAssessment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "continues",
            "updates",
            "replaces",
            "cancels",
            "completes",
            "resolves",
            "reopens"
          ]
        },
        "changed_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "scope",
              "owner",
              "deadline",
              "status"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "prior_evidence_da_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "current_evidence_da_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "relation",
        "changed_fields",
        "reason",
        "prior_evidence_da_ids",
        "current_evidence_da_ids"
      ],
      "additionalProperties": false
    },
    "relationFinding": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "uncertain",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "da_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "da_id",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "enum": [
              "statement",
              "owner",
              "deadline",
              "status",
              "related_items"
            ]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationAssessment"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentSelection"
          }
        }
      },
      "required": [
        "result",
        "reason",
        "quotes",
        "fields"
      ],
      "additionalProperties": false
    },
    "documentSelection": {
      "type": "object",
      "properties": {
        "passage_id": {
          "type": "string"
        },
        "result": {
          "enum": [
            "supports",
            "context",
            "irrelevant",
            "contradicts",
            "uncertain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "passage_id",
        "result",
        "reason"
      ],
      "additionalProperties": false
    },
    "documentPassage": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "project_document"
        },
        "passage_id": {
          "type": "string"
        },
        "source": {
          "const": "amiScenario.pdf"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "search",
            "read"
          ]
        },
        "page_length": {
          "type": "integer",
          "minimum": 1
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page_metadata": {
          "type": "object"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "passage_id",
        "source",
        "source_sha256",
        "page",
        "start",
        "end",
        "text",
        "origin",
        "page_length",
        "next_offset",
        "page_metadata"
      ],
      "additionalProperties": false
    },
    "documentEvidence": {
      "type": "object",
      "properties": {
        "check": {
          "enum": [
            "statement",
            "owner",
            "deadline",
            "status",
            "conflict",
            "relation"
          ]
        },
        "passage_id": {
          "type": "string"
        },
        "result": {
          "enum": [
            "supports",
            "context",
            "irrelevant",
            "contradicts",
            "uncertain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "retained": {
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/documentPassage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "check",
        "passage_id",
        "result",
        "reason",
        "retained",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
